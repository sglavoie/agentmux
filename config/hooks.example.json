{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator idle prompt",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log session_start",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active subagent_start",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log subagent_start",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active subagent_stop",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log subagent_stop",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active prompt",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active tool",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log tool",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator failure",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator permission",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator stop",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log stop",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active task_complete",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log task",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [],
    "Notification": [],
    "TeammateIdle": [],
    "ConfigChange": [],
    "WorktreeCreate": [],
    "WorktreeRemove": [],
    "PreCompact": [],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator stop",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log end",
            "async": true
          }
        ]
      }
    ]
  },
  "account_overrides": {
    "personal": {
      "disabled_events": ["Notification"],
      "extra_commands": {
        "Stop": [
          {
            "type": "command",
            "command": "/path/to/custom-stop-handler.sh",
            "async": true
          }
        ]
      }
    }
  }
}
