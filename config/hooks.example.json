{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active prompt",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active tool",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log tool",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator failure",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator permission",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator stop",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log stop",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator active task_complete",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cc-hook-indicator stop",
            "async": true
          },
          {
            "type": "command",
            "command": "cc-activity-log end",
            "async": true
          }
        ]
      }
    ]
  },
  "account_overrides": {}
}
