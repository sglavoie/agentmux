# cc-manager account definitions
#
# Format: name | claude_config_dir | color
#
# name             — Account identifier (referenced in sessions.conf)
# claude_config_dir — Path to Claude config directory (empty or ~/.claude = default)
# color            — Tab color from built-in palette:
#                    green, blue, red, orange, purple, teal, pink, yellow, gray, cyan
#
# Lines starting with # are comments. Blank lines are ignored.
# Whitespace around the pipe delimiters is trimmed.

work     | ~/.claude            | green
personal | ~/.claude-personal   | blue

# Add more accounts as needed:
# client-x | ~/.claude-client-x   | orange
