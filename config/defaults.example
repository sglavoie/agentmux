# cc-manager global defaults
#
# Format: key = value
#
# Supported keys:
#   claude_flags    — Extra flags passed to every Claude session
#                     (e.g. --dangerously-skip-permissions)
#   project_window  — Open a shell window alongside Claude in each tab.
#                     Values: (empty) = disabled, stack, vsplit, hsplit, split
#                     With "stack", only one window is visible at a time;
#                     toggle with Kitty shortcuts (e.g. ctrl+shift+]).
#   sort_sessions   — Sort sessions alphabetically by title on launch.
#                     Values: (empty) = preserve file order, alpha = alphabetical
#                     Useful for grouping tabs by account prefix (P:, T:, W:, etc.).
#                     Also reorders live tabs after creating or restarting sessions
#                     so new tabs land in sorted position rather than at the end.
#   dashboard_refresh — Auto-refresh interval (seconds) for the dashboard.
#                       Values: 0 = disabled, any positive integer = interval
#                       Default: 3
#   notify_error      — Show a macOS notification on tool use failures.
#                       Values: on, (empty/off) = disabled. Default: off.
#   notify_permission — Show a macOS notification on permission requests.
#                       Values: on, (empty/off) = disabled. Default: off.
#   notify_stop       — Show a macOS notification when a session stops.
#                       Values: on, (empty/off) = disabled. Default: off.
#   idle_alert_minutes — Highlight sessions idle longer than this threshold
#                        in the dashboard (yellow). Values: 0 or omitted = disabled,
#                        any positive integer = minutes. Default: 0.
#   notify_idle        — Show a macOS notification when a session exceeds the
#                        idle_alert_minutes threshold. Only fires once per idle
#                        period (resets when the session becomes active again).
#                        Values: on, (empty/off) = disabled. Default: off.
#   notify_min_secs    — Minimum seconds since last activity before any
#                        notification (stop, error, permission) fires.
#                        If an event arrives within this window, the
#                        notification is suppressed (e.g. after /clear).
#                        The tab icon is unaffected.
#                        Values: 0 = disabled, any positive integer.
#                        Default: 0.
#   notify_ignore_patterns — Pipe-separated regex patterns matched against
#                            the current Kitty screen content. If any pattern
#                            matches, the notification is suppressed.
#                            Example: Conversation cleared|Context compacted
#                            Default: empty (disabled).
#
# Lines starting with # are comments. Blank lines are ignored.
# Whitespace around the = delimiter is trimmed.
# --- END OF DOCUMENTATION (do not edit above this line) ---

# claude_flags = --dangerously-skip-permissions
# project_window = stack
# sort_sessions = alpha
# dashboard_refresh = 3
# notify_error = on
# notify_permission = on
# notify_stop = off
# idle_alert_minutes = 30
# notify_idle = on
# notify_min_secs = 3
# notify_ignore_patterns = Conversation cleared|Context compacted
