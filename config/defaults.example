# cc-manager global defaults
#
# Format: key = value
#
# Supported keys:
#   claude_flags    — Extra flags passed to every Claude session
#                     (e.g. --dangerously-skip-permissions)
#   project_window  — Open a shell window alongside Claude in each tab.
#                     Values: (empty) = disabled, stack, vsplit, hsplit, split
#                     With "stack", only one window is visible at a time;
#                     toggle with Kitty shortcuts (e.g. ctrl+shift+]).
#   sort_sessions   — Sort sessions alphabetically by title on launch.
#                     Values: (empty) = preserve file order, alpha = alphabetical
#                     Useful for grouping tabs by account prefix (P:, T:, W:, etc.).
#
# Lines starting with # are comments. Blank lines are ignored.
# Whitespace around the = delimiter is trimmed.

# claude_flags = --dangerously-skip-permissions
# project_window = stack
# sort_sessions = alpha
