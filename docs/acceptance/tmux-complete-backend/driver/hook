#!/bin/sh
# Runs on the Studio as a real harness's hook command (see `world`): hands the
# payload on standard input to `hookrelay` on the MacBook over the held SSH
# connection. It authenticates nothing: without that connection it fails.
# usage: hook NAME EVENT [ARG...]
host=$(cat /tmp/amx75/host)
exec ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ControlMaster=no -o ControlPath=/tmp/amx75/cm-%C "$host" "/tmp/amx75w/driver/hookrelay $*"
