#!/bin/bash
# Brings the two-machine world up or down. Runs on the Studio.
#   up:   on the MacBook, the world's daemon (no Kitty) and one tmux session
#         per project, launched by `amx project launch` on the backend the
#         world's config names; on the Studio, the three real harnesses,
#         headless, each joined to its pane by bridge.py, and the mirror that
#         carries Copilot's session transcript to the world's Copilot home
#         (the daemon reads that file; the harness writes it on the Studio).
#   down: quits the app copy, ends every session, stops the daemon, the
#         private tmux server and the observer on the MacBook, and the
#         bridges, harnesses and mirror on the Studio.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/env"
real() { echo "$L/run-$1"; }
case "${1:-}" in
up)
  rr <<'REMOTE' || exit 1
perl -e 'alarm 25; exec @ARGV' osascript -e 'tell application "System Events" to do shell script "/tmp/amx75w/driver/daemon-start"' >/dev/null
n=40; while [ $n -gt 0 ] && [ ! -S $DATA/daemon.sock ]; do sleep 0.25; n=$((n-1)); done
[ -S $DATA/daemon.sock ] || { echo "daemon did not start"; tail -5 $R/logs/daemon.out; exit 1; }
for p in claude codex copilot plain; do
  amx project launch $p --profile $p --json > $R/logs/launch-$p.json 2>&1 || { echo "launch $p failed"; cat $R/logs/launch-$p.json; exit 1; }
done
n=60; while [ $n -gt 0 ] && [ "$(ls $R/bridge/*.sock 2>/dev/null | wc -l | tr -d ' ')" != 3 ]; do sleep 0.25; n=$((n-1)); done
ls $R/bridge/
REMOTE
  # The harnesses: on the Studio, with no AgentMux, Kitty, ASL, or askpass
  # variable, and none of this run's guard directories on PATH.
  clean=$(env | grep -E '^(ASL_|AMX_|KITTY_|CLAUDE_CODE|CLAUDECODE|CLAUDE_PID|CLAUDE_EFFORT|SSH_ASKPASS|DISPLAY|TMUX)' | cut -d= -f1 | sed 's/^/-u /' | tr '\n' ' ')
  path=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v -e agent-session-loop -e '/codex/.codex/' | paste -sd: -)
  date +%s > $L/world.started; touch $L/world.stamp
  # session-15's bridge.py starts its own ssh; this puts the held connection
  # under it, so it authenticates nothing.
  mkdir -p $L/sshbin
  printf '#!/bin/sh\nexec /usr/bin/ssh -o BatchMode=yes -o ControlMaster=no -o ControlPath=%s/cm-%%C "$@"\n' $L > $L/sshbin/ssh; chmod +x $L/sshbin/ssh
  for h in claude codex copilot; do
    PATH=$L/sshbin:$PATH nohup /bin/sh -c "cd $L/proj/$h && exec python3 '$S15/bridge.py' serve '$H' $R/driver/bridge.py $R/bridge/$h.sock -- env $clean PATH='$path' $(real $h)" > $L/logs/serve-$h.log 2>&1 </dev/null &
  done
  # Copilot's transcript mirror (see `mirror`).
  nohup "$here/mirror" "$H" $L/world.stamp > $L/logs/mirror.log 2>&1 </dev/null &
  echo $! > $L/mirror.pid
  sleep 8
  rr <<'REMOTE'
n=80; while [ $n -gt 0 ] && [ "$(snapshot | grep -c 'runtime=tmux')" != 4 ]; do sleep 0.25; n=$((n-1)); done
snapshot; registry; cat $R/logs/hooks.log 2>/dev/null
REMOTE
  for h in claude codex copilot; do echo "$h on the Studio: $(tr '\n' ' ' < $L/logs/serve-$h.log)"; done
  ;;
down)
  # The Studio first: a harness that ends fires its last hooks, and a hook
  # that finds no daemon starts one.
  [ -f $L/mirror.pid ] && kill "$(cat $L/mirror.pid)" 2>/dev/null
  rm -f $L/mirrored.* $L/mirror.pid
  pkill -f "bridge.py serve $H" 2>/dev/null
  sleep 3
  echo "left on the Studio: $(pgrep -fl 'bridge.py serve' | tr '\n' ';')"
  rr <<'REMOTE'
app_quit
amx backend stop --yes 2>&1 | tail -2
amx daemon stop >/dev/null 2>&1
priv kill-server 2>/dev/null
obs kill-server 2>/dev/null
sleep 1
for p in $(pgrep -f "$R/bin/amx (daemon|hook-indicator)"); do kill "$p" 2>/dev/null; done
sleep 1
rm -rf $R/home/.local $R/tmp/* $R/logs/* $R/bridge/* $R/app.started $R/logmark $R/obs.sock $R/home/.copilot-w/session-state
mkdir -p $R/tmp $R/logs
defaults delete $BUNDLE >/dev/null 2>&1
prefs="$REAL_HOME/Library/Preferences/$BUNDLE.plist"
[ ! -f "$prefs" ] || rm -- "$prefs"
echo "left on the MacBook: $(pgrep -fl "$R/" | grep -v 'bash -s' | cut -c1-80 | tr '\n' ';')"
REMOTE
  ;;
*) echo "usage: world up|down"; exit 2;;
esac
