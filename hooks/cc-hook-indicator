#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-hook-indicator/main.sh
source "$LIB_DIR/cc-hook-indicator/main.sh"

cc_hook_indicator_main "$@"
