#!/usr/bin/env bash
set -euo pipefail

# cc-hook-indicator — Set state icon prefix on the current tab's title.
# Called by Claude Code hooks with "active", "stop", "permission", "idle", "failure", or "clear" as $1.
# Relies on KITTY_WINDOW_ID being set in the environment (Kitty sets this
# automatically for all processes inside its windows).

if [[ $# -lt 1 ]]; then
    echo "Usage: cc-hook-indicator active|stop|permission|idle|failure|clear [EVENT_KIND] [WINDOW_ID]" >&2
    exit 1
fi

ACTION="$1"
EVENT_KIND=""

# Parse remaining args: $2 can be an event kind (prompt, tool, etc.) or a
# numeric window ID (backward compat with F4 keybinding).  $3, if present,
# is always a window ID.
if [[ $# -ge 3 ]]; then
    EVENT_KIND="$2"
    KITTY_WINDOW_ID="$3"
elif [[ $# -ge 2 ]]; then
    if [[ "$2" =~ ^[0-9]+$ ]]; then
        # Numeric = window ID (backward compat: "cc-hook-indicator clear <WINDOW_ID>")
        KITTY_WINDOW_ID="$2"
    else
        EVENT_KIND="$2"
    fi
fi

if [[ -z "${KITTY_WINDOW_ID:-}" ]]; then
    echo "Error: KITTY_WINDOW_ID is not set" >&2
    exit 1
fi

# Resolve the lib directory by following the symlink.
SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-title-icons.sh
source "$LIB_DIR/cc-title-icons.sh"

# Load notification settings from defaults.conf.
load_defaults

# ---------------------------------------------------------------------------
# macOS desktop notification helper (cooldown prevents spam)
# ---------------------------------------------------------------------------
_NOTIFY_COOLDOWN=10  # seconds between duplicate notifications

_maybe_notify() {
    local enabled="$1" subtitle="$2" session_label="$3"
    [[ "$enabled" == "on" ]] || return 0

    local cooldown_file="/tmp/ccm-notify-${ACTION}-${tab_id}"
    if [[ -f "$cooldown_file" ]]; then
        local now last_time
        now=$(date +%s)
        last_time=$(stat -f %m "$cooldown_file" 2>/dev/null || echo 0)
        if (( now - last_time < _NOTIFY_COOLDOWN )); then
            return 0
        fi
    fi
    touch "$cooldown_file"

    osascript -e "display notification \"${session_label} needs attention\" with title \"cc-manager\" subtitle \"${subtitle}\"" 2>/dev/null || true
}

# Discover the Kitty socket.
TO_ARGS=()
if [[ -n "${KITTY_LISTEN_ON:-}" ]]; then
    TO_ARGS=("--to" "$KITTY_LISTEN_ON")
fi

# Get current tab info.
info="$(get_tab_info "$KITTY_WINDOW_ID" ${TO_ARGS[@]+"${TO_ARGS[@]}"})"
tab_id="$(echo "$info" | head -n1)"
current_title="$(echo "$info" | tail -n1)"

if [[ -z "$tab_id" || "$tab_id" == "null" ]]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# Activity tracking — write compact state file for dashboard consumption
# ---------------------------------------------------------------------------
_update_activity() {
    local activity_file="/tmp/ccm-activity-${tab_id}.counts"
    local now
    now=$(date +%s)

    # Determine event kind from EVENT_KIND (if present) or derive from ACTION
    local event_kind="$EVENT_KIND"
    if [[ -z "$event_kind" ]]; then
        case "$ACTION" in
            active)     event_kind="prompt" ;;
            failure)    event_kind="failure" ;;
            permission) event_kind="permission" ;;
            stop)       event_kind="stop" ;;
            *)          event_kind="" ;;
        esac
    fi

    # Skip tracking for clear/idle actions
    [[ -z "$event_kind" ]] && return 0

    # Read existing counts (9 lines: first_event_ts, last_event_ts,
    # last_event_type, prompt_count, tool_use_count, tool_failure_count,
    # permission_count, stop_count, last_attention_ts)
    local first_ts="$now" last_ts="$now" last_type="$event_kind"
    local prompts=0 tools=0 failures=0 permissions=0 stops=0 attention_ts=0

    if [[ -f "$activity_file" ]]; then
        local i=0
        while IFS= read -r line; do
            case $i in
                0) first_ts="$line" ;; 1) last_ts="$line" ;; 2) last_type="$line" ;;
                3) prompts="$line" ;; 4) tools="$line" ;; 5) failures="$line" ;;
                6) permissions="$line" ;; 7) stops="$line" ;; 8) attention_ts="$line" ;;
            esac
            i=$((i + 1))
        done < "$activity_file"
        # Ensure numeric defaults for any missing/corrupt values
        first_ts="${first_ts:-$now}"
        prompts="${prompts:-0}"
        tools="${tools:-0}"
        failures="${failures:-0}"
        permissions="${permissions:-0}"
        stops="${stops:-0}"
        attention_ts="${attention_ts:-0}"
    fi

    last_ts="$now"
    last_type="$event_kind"

    case "$event_kind" in
        prompt)     prompts=$((prompts + 1)) ;;
        tool)       tools=$((tools + 1)) ;;
        failure)    failures=$((failures + 1)); attention_ts="$now" ;;
        permission) permissions=$((permissions + 1)); attention_ts="$now" ;;
        stop)       stops=$((stops + 1)) ;;
    esac

    local tmpfile="${activity_file}.tmp.$$"
    printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
        "$first_ts" "$last_ts" "$last_type" \
        "$prompts" "$tools" "$failures" "$permissions" "$stops" "$attention_ts" \
        > "$tmpfile" && mv "$tmpfile" "$activity_file"
}

_update_activity

# Determine current icon state.
has_star=false
remaining="$current_title"
if [[ "$remaining" == "${_ICON_STAR}"* ]]; then
    has_star=true
    remaining="${remaining#"$_ICON_STAR"}"
fi

# Strip any existing state icon to get the base title.
remaining="$(strip_icons "$remaining")"

# Apply the requested action.
case "$ACTION" in
    active)
        state="bolt"
        ;;
    stop)
        state="stop"
        ;;
    permission)
        state="key"
        ;;
    idle)
        state=""
        ;;
    failure)
        state="error"
        ;;
    clear)
        state=""
        ;;
    *)
        echo "Error: unknown action '$ACTION' (expected 'active', 'stop', 'permission', 'idle', 'failure', or 'clear')" >&2
        exit 1
        ;;
esac

new_title="$(build_title "$remaining" "$has_star" "$state")"

# Send macOS desktop notification if enabled for this event type.
case "$ACTION" in
    failure)    _maybe_notify "$_DEFAULT_NOTIFY_ERROR" "Error" "$remaining" ;;
    permission) _maybe_notify "$_DEFAULT_NOTIFY_PERMISSION" "Permission Required" "$remaining" ;;
    stop)       _maybe_notify "$_DEFAULT_NOTIFY_STOP" "Stopped" "$remaining" ;;
esac

# Only update if the title actually changed.
if [[ "$new_title" != "$current_title" ]]; then
    kitten @ ${TO_ARGS[@]+"${TO_ARGS[@]}"} set-tab-title --match "id:$tab_id" "$new_title" 2>/dev/null || true
fi

# Manage scrollback markers for error states.
if [[ "$ACTION" == "failure" ]]; then
    kitten @ ${TO_ARGS[@]+"${TO_ARGS[@]}"} create-marker --match "id:$KITTY_WINDOW_ID" iregex 1 '\bError\b' 2 '\bFailed\b' 3 '\bWarning\b' 3 '\bDEPRECATED\b' 2>/dev/null || true
elif [[ "$ACTION" == "active" || "$ACTION" == "clear" ]]; then
    kitten @ ${TO_ARGS[@]+"${TO_ARGS[@]}"} remove-marker --match "id:$KITTY_WINDOW_ID" 2>/dev/null || true
fi
