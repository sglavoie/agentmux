#compdef cc-launch

# Zsh completion for cc-launch — Claude Code session manager for Kitty.
# Installed to ~/.zfunc/ by `make install`.

_cc_launch_tab_titles() {
    local -a titles
    titles=(${(f)"$(cc-launch --list 2>/dev/null | tail -n +3 | awk '{print $4}')"})
    [[ ${#titles} -gt 0 ]] && _describe 'tab title' titles
}

_cc_launch_tab_ids() {
    local -a ids
    ids=(${(f)"$(cc-launch --list 2>/dev/null | tail -n +3 | awk '{print $3}')"})
    [[ ${#ids} -gt 0 ]] && _describe 'kitty tab id' ids
}

_cc_launch_instances() {
    local -a inst
    inst=(${(f)"$(cc-launch --sockets 2>/dev/null | awk '/^unix:\/tmp\/kitty-/ {print $1}' | sed -E 's#^unix:/tmp/kitty-([0-9]+)$#K:\1#')"})
    [[ ${#inst} -gt 0 ]] && _describe 'kitty instance label' inst
}

_cc_launch_sockets() {
    local -a socks
    socks=(/tmp/kitty-*(N))
    [[ ${#socks} -gt 0 ]] && _describe 'kitty socket' socks
}

_cc_launch_accounts() {
    local accounts_file="${CC_MANAGER_ACCOUNTS:-${XDG_CONFIG_HOME:-$HOME/.config}/cc-manager/accounts.conf}"
    local -a accts
    if [[ -f "$accounts_file" ]]; then
        accts=(${(f)"$(command grep -v '^\s*#' "$accounts_file" | command grep -v '^\s*$' | cut -d'|' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"})
    else
        accts=(work personal)
    fi
    [[ ${#accts} -gt 0 ]] && _values 'account' $accts
}

_cc-launch() {
    local context state state_descr line
    typeset -A opt_args

    # Handle --socket as a global option that can precede any subcommand
    if [[ "$words[2]" == "--socket" ]]; then
        case $CURRENT in
            3)
                _cc_launch_sockets
                return
                ;;
            *)
                # Shift context past --socket ARG and complete the subcommand
                local subcmd="$words[4]"
                case "$subcmd" in
                    --add)
                        case $CURRENT in
                            5) _message 'title' ;;
                            6) _files -/ ;;
                            7) _cc_launch_accounts ;;
                        esac
                        return
                        ;;
                    --close)
                        case $CURRENT in
                            5|7) _cc_launch_instances ;;
                            6|8) _cc_launch_tab_ids ;;
                        esac
                        return
                        ;;
                    --restart)
                        case $CURRENT in
                            5|7) _cc_launch_instances ;;
                            6|8) _cc_launch_tab_ids ;;
                        esac
                        return
                        ;;
                    --clone)
                        case $CURRENT in
                            5|7) _cc_launch_instances ;;
                            6|8) _cc_launch_tab_ids ;;
                        esac
                        return
                        ;;
                    --move)
                        case $CURRENT in
                            5|7) _cc_launch_instances ;;
                            6|8) _cc_launch_tab_ids ;;
                            9|10) _cc_launch_instances ;;
                        esac
                        return
                        ;;
                    --save)
                        [[ $CURRENT -eq 5 ]] && _files
                        return
                        ;;
                    *)
                        _values 'command' \
                            '--all[Launch all sessions from config]' \
                            '--add[Launch a single ad-hoc session tab]' \
                            '--close[Close a tab by stable selector]' \
                            '--restart[Restart a session by stable selector]' \
                            '--clone[Clone a session by stable selector]' \
                            '--move[Move a session between Kitty instances]' \
                            '--list[List open tabs running Claude]' \
                            '--save[Save current sessions to config file]' \
                            '--cleanup[Find and close stale sessions]' \
                            '--sockets[List available Kitty sockets]' \
                            '--instance[Source Kitty instance label]' \
                            '--tab-id[Kitty tab id in selected instance]' \
                            '--target-instance[Destination Kitty instance label for --move]' \
                            '--help[Show help message]'
                        return
                        ;;
                esac
                ;;
        esac
    fi

    case "$words[2]" in
        --add)
            case $CURRENT in
                3) _message 'title' ;;
                4) _files -/ ;;
                5) _cc_launch_accounts ;;
            esac
            ;;
        --close)
            case $CURRENT in
                3|5) _cc_launch_instances ;;
                4|6) _cc_launch_tab_ids ;;
            esac
            ;;
        --restart)
            case $CURRENT in
                3|5) _cc_launch_instances ;;
                4|6) _cc_launch_tab_ids ;;
            esac
            ;;
        --clone)
            case $CURRENT in
                3|5) _cc_launch_instances ;;
                4|6) _cc_launch_tab_ids ;;
            esac
            ;;
        --move)
            case $CURRENT in
                3|5) _cc_launch_instances ;;
                4|6) _cc_launch_tab_ids ;;
                7|8) _cc_launch_instances ;;
            esac
            ;;
        --save)
            [[ $CURRENT -eq 3 ]] && _files
            ;;
        *)
            _values 'command' \
                '--all[Launch all sessions from config]' \
                '--add[Launch a single ad-hoc session tab]' \
                '--close[Close a tab by stable selector]' \
                '--restart[Restart a session by stable selector]' \
                '--clone[Clone a session by stable selector]' \
                '--move[Move a session between Kitty instances]' \
                '--list[List open tabs running Claude]' \
                '--save[Save current sessions to config file]' \
                '--cleanup[Find and close stale sessions]' \
                '--sockets[List available Kitty sockets]' \
                '--socket[Target a specific Kitty socket]' \
                '--instance[Source Kitty instance label]' \
                '--tab-id[Kitty tab id in selected instance]' \
                '--target-instance[Destination Kitty instance label for --move]' \
                '--help[Show help message]'
            ;;
    esac
}

_cc-launch "$@"
