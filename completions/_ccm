#compdef ccm

# Zsh completion for ccm — Claude Code Manager CLI.
# Installed to ~/.zfunc/ by `make install`.

_ccm_config_files() {
    local -a files
    files=(
        'accounts:Account definitions (name, config dir, color)'
        'sessions:Session definitions (title, directory, account)'
        'defaults:Global defaults (claude flags)'
        'hooks:Hook configuration (JSON)'
    )
    _describe 'config file' files
}

_ccm_sockets() {
    local -a socks
    socks=(/tmp/kitty-*(N))
    [[ ${#socks} -gt 0 ]] && _describe 'kitty socket' socks
}

_ccm() {
    local context state state_descr line
    typeset -A opt_args

    # Handle --socket as a global option that can precede any subcommand
    if [[ "$words[2]" == "--socket" ]]; then
        case $CURRENT in
            3)
                _ccm_sockets
                return
                ;;
            *)
                # Shift context past --socket ARG and complete the subcommand
                local subcmd="$words[4]"
                case "$subcmd" in
                    config)
                        local config_sub="$words[5]"
                        case "$config_sub" in
                            edit|show|path)
                                [[ $CURRENT -eq 6 ]] && _ccm_config_files
                                return
                                ;;
                            *)
                                [[ $CURRENT -eq 5 ]] && _values 'config subcommand' \
                                    'edit[Open config file in editor]' \
                                    'show[Print config file contents]' \
                                    'path[Print config file path]' \
                                    'init[Copy example configs if missing]' \
                                    'sync[Update documentation preambles]'
                                return
                                ;;
                        esac
                        ;;
                    launch)
                        # Delegate to cc-launch completions for remaining args
                        shift 3 words
                        (( CURRENT -= 3 ))
                        _cc-launch
                        return
                        ;;
                    *)
                        _values 'command' \
                            'launch[Manage and launch Claude Code sessions]' \
                            'status[Show active session status table]' \
                            'star[Toggle star on active tab]' \
                            'config[Manage config files]' \
                            'hooks[Manage hooks]' \
                            'logs[Query and manage activity logs]' \
                            'dashboard[Launch curses dashboard kitten]' \
                            'switch[Quick-switch to a session]' \
                            'idle-watch[Manage background idle watcher]' \
                            'help[Show help]'
                        return
                        ;;
                esac
                ;;
        esac
    fi

    case "$words[2]" in
        config)
            local config_sub="$words[3]"
            case "$config_sub" in
                edit|show|path)
                    [[ $CURRENT -eq 4 ]] && _ccm_config_files
                    ;;
                *)
                    [[ $CURRENT -eq 3 ]] && _values 'config subcommand' \
                        'edit[Open config file in editor]' \
                        'show[Print config file contents]' \
                        'path[Print config file path]' \
                        'init[Copy example configs if missing]' \
                                    'sync[Update documentation preambles]'
                    ;;
            esac
            ;;
        launch)
            # Delegate to cc-launch completions for remaining args
            shift words
            (( CURRENT -= 1 ))
            _cc-launch
            ;;
        idle-watch)
            [[ $CURRENT -eq 3 ]] && _values 'idle-watch command' \
                '--start[Start the background idle watcher]' \
                '--stop[Stop a running idle watcher]' \
                '--status[Check whether the idle watcher is running]'
            ;;
        logs)
            local logs_sub="$words[3]"
            case "$logs_sub" in
                show|summary)
                    # Complete session IDs from log filenames.
                    if [[ $CURRENT -eq 4 ]]; then
                        local log_dir="${CC_MANAGER_LOGS:-${XDG_STATE_HOME:-$HOME/.local/state}/cc-manager/activity}"
                        if [[ -d "$log_dir" ]]; then
                            local -a sessions
                            sessions=(${log_dir}/*.jsonl(N:t:r))
                            [[ ${#sessions} -gt 0 ]] && _describe 'session id' sessions
                        fi
                    fi
                    ;;
                clean)
                    [[ $CURRENT -ge 4 ]] && _values 'clean option' \
                        '--older-than[Age threshold in days]' \
                        '--dry-run[Preview without deleting]'
                    ;;
                *)
                    [[ $CURRENT -eq 3 ]] && _values 'logs subcommand' \
                        'list[List all session log files]' \
                        'show[Show log entries for a session]' \
                        'summary[Print aggregate summary for a session]' \
                        'clean[Delete old log files]' \
                        'dir[Print the log directory path]'
                    ;;
            esac
            ;;
        help)
            [[ $CURRENT -eq 3 ]] && _values 'command' \
                'launch' 'status' 'star' 'config' 'hooks' 'logs' 'dashboard' 'switch' 'idle-watch'
            ;;
        *)
            _values 'command' \
                'launch[Manage and launch Claude Code sessions]' \
                'status[Show active session status table]' \
                'star[Toggle star on active tab]' \
                'config[Manage config files]' \
                'hooks[Manage hooks]' \
                'logs[Query and manage activity logs]' \
                'dashboard[Launch curses dashboard kitten]' \
                'switch[Quick-switch to a session]' \
                'idle-watch[Manage background idle watcher]' \
                'help[Show help]' \
                '--socket[Target a specific Kitty socket]' \
                '--version[Print version]'
            ;;
    esac
}

_ccm "$@"
