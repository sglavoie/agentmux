#!/usr/bin/env bash
# publish-release preflight AMX_ROOT ASL_ROOT SIGNING_KEY
# publish-release prepare AMX_ROOT ASL_ROOT SIGNING_KEY NEXT_VERSION
# publish-release publish AMX_ROOT PAIR_RECORD DESKTOP_RECORD
#
# The GitHub half of a release. The paired release gate decides whether a pair
# is releasable and tags it locally, and the desktop gate whether the notarized
# app is; this script only publishes what both already claimed: it pushes the
# pair tag to both repositories' `origin` and creates (or completes) the GitHub
# release for Agent Mux, with the notarized app, a notarized amx, and both
# evidence records.
#
# `preflight` runs before the gates and checks what would otherwise fail only
# after an hour of them: gh is signed in, both trees are clean and their HEAD
# is already on origin/main, this version has no release yet, and the app can
# be built, signed with Developer ID, and notarized (release-gate.sh
# toolchain --notarized).
#
# `prepare` checks the next version before ship-release writes its version
# commit. Agent Mux may be ahead of origin/main; ASL must already be pushed.
#
# `publish` reads everything from the two evidence records, never from the
# current checkout, and refuses a pair record that is not a signed pass naming
# both tags or a desktop record that is not a signed, notarized, non-rehearsal
# pass of the same revision. It is safe to re-run: a tag already on origin is
# not pushed again, and a release that already exists only has its assets
# replaced.
#
# Both need AMX_CODESIGN_IDENTITY (a Developer ID Application identity) and
# AMX_NOTARY_PROFILE (an `xcrun notarytool store-credentials` profile).
set -euo pipefail

die() {
    echo "publish-release: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

# gh_repo prints owner/name of the GitHub repository a checkout's origin is.
gh_repo() {
    (cd "$1" && gh repo view --json nameWithOwner --jq .nameWithOwner)
}

# require_on_origin_main refuses a revision GitHub's main does not contain: a
# release tag on a commit nobody can reach from the default branch is a release
# of something that was never published.
require_on_origin_main() {
    local root="$1" rev="$2"
    git -C "$root" fetch --quiet origin main
    if ! git -C "$root" merge-base --is-ancestor "$rev" origin/main; then
        die "$root: ${rev:0:12} is not on origin/main; push main first"
    fi
}

# version_at prints Agent Mux's version constant as of a revision.
version_at() {
    git -C "$1" show "$2:cmd/root.go" | sed -n 's/^const version = "\(.*\)"$/\1/p'
}

# require_signed_record RECORD NAMESPACE refuses a record that is not a
# signed pass whose detached signature covers it under NAMESPACE.
require_signed_record() {
    local record="$1" namespace="$2"
    [ -f "$record" ] || die "no evidence record at $record"
    local result
    result="$(jq -r .result "$record")"
    [ "$result" = passed ] || die "$record is $result, not passed; nothing to publish"
    [ "$(jq -r .signature.signed "$record")" = true ] || die "$record is unsigned: a rehearsal, not a release"
    [ -f "$record.sig" ] || die "no signature beside $record"
    ssh-keygen -Y check-novalidate -n "$namespace" -s "$record.sig" <"$record" >/dev/null 2>&1 ||
        die "$record.sig does not verify $record under $namespace"
}

require_signing_env() {
    [ -n "${AMX_CODESIGN_IDENTITY:-}" ] || die "AMX_CODESIGN_IDENTITY must name the Developer ID Application identity"
    [ -n "${AMX_NOTARY_PROFILE:-}" ] || die "AMX_NOTARY_PROFILE must name a notarytool keychain profile"
}

preflight() {
    local amx_root="$1" asl_root="$2" signing_key="$3" next_version="${4:-}"
    need gh
    need jq
    gh auth status >/dev/null 2>&1 || die "gh is not signed in (gh auth login)"
    [ -f "$signing_key" ] || die "no signing key at $signing_key"

    local root
    for root in "$amx_root" "$asl_root"; do
        [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || die "$root is not a Git checkout"
        if [ -n "$(git -C "$root" status --porcelain)" ]; then
            die "$root has uncommitted changes"
        fi
        if [ "$root" = "$amx_root" ] && [ -n "$next_version" ]; then
            git -C "$root" fetch --quiet origin main
            git -C "$root" merge-base --is-ancestor origin/main HEAD ||
                die "$root is behind or diverged from origin/main; update main first"
        else
            require_on_origin_main "$root" "$(git -C "$root" rev-parse HEAD)"
        fi
    done

    local repo version releases
    repo="$(gh_repo "$amx_root")"
    version="${next_version:-$(version_at "$amx_root" HEAD)}"
    [ -n "$version" ] || die "cannot read the version from cmd/root.go"
    releases="$(gh release list --repo "$repo" --limit 1000 --json name --jq '.[].name')"
    if grep -qxF "amx $version" <<< "$releases"; then
        die "$repo already has a release for amx $version; run just bump first"
    fi
    require_signing_env
    "$amx_root/macos/scripts/release-gate.sh" toolchain --notarized >/dev/null ||
        die "the app cannot be built, signed, and notarized (above)"
    echo "preflight: releasing amx $version from $repo"
}

publish() {
    local amx_root="$1" record="$2" desktop="$3"
    need gh
    need jq
    require_signing_env
    require_signed_record "$record" agentmux-asl-release
    require_signed_record "$desktop" agentmux-desktop-release
    local sig="$record.sig" pair_id
    pair_id="$(jq -r .pair_id "$record")"
    [ "$(jq '.tags | length' "$record")" -eq 2 ] || die "$record does not name a tag in both repositories"

    # Every repository the record names has to carry the pair tag on the
    # revision the record says, and that revision has to be on origin/main,
    # before anything is pushed anywhere.
    local repo root rev tagged
    while IFS=$'\t' read -r repo root rev; do
        tagged="$(git -C "$root" rev-parse --verify --quiet "refs/tags/$pair_id^{commit}")" ||
            die "$root has no tag $pair_id"
        [ "$tagged" = "$rev" ] || die "$root: $pair_id is on ${tagged:0:12}, the record says ${rev:0:12}"
        require_on_origin_main "$root" "$rev"
    done < <(jq -r '.repositories[] | [.repo, .root, .revision] | @tsv' "$record")

    # The amx released is the one the pair gate hashed, or nothing is released.
    local amx_rev amx_sha arch version build_id
    amx_rev="$(jq -r '.repositories[] | select(.repo == "agentmux") | .revision' "$record")"
    amx_sha="$(jq -r '.artifacts[] | select(.name == "amx") | .sha256' "$record")"
    arch="$(jq -r .environment.arch "$record")"
    version="$(version_at "$amx_root" "$amx_rev")"
    [ -n "$amx_rev" ] && [ -n "$amx_sha" ] && [ -n "$version" ] || die "$record does not name the amx revision, hash, and version"
    [ -f "$amx_root/amx" ] || die "no amx in $amx_root; check out ${amx_rev:0:12} and run just build"
    if [ "$(shasum -a 256 "$amx_root/amx" | cut -d' ' -f1)" != "$amx_sha" ]; then
        die "$amx_root/amx is not the binary the gate released; check out ${amx_rev:0:12} and run just build"
    fi
    build_id="$(go tool buildid "$amx_root/amx")"

    # The app is the one the desktop gate passed: same revision, notarization
    # required, not a rehearsal, bundling this amx, and still stapled.
    local app="$amx_root/macos/build/Agent Mux.app"
    fact() { jq -r --arg n "$1" '.bundle[] | select(.name == $n) | .value' "$desktop"; }
    [ "$(jq -r .gate "$desktop")" = desktop ] || die "$desktop is not a desktop record"
    [ "$(jq -r .rehearsal "$desktop")" = false ] || die "$desktop is a rehearsal"
    [ "$(jq -r .notarized_required "$desktop")" = true ] || die "$desktop did not require notarization"
    [ "$(jq -r .repository.revision "$desktop")" = "$amx_rev" ] ||
        die "$desktop is of another revision than the pair's agentmux ${amx_rev:0:12}"
    [ "$(fact distribution)" = notarized ] || die "$desktop does not record a notarized bundle"
    [ "$(fact amx_go_build_id)" = "$build_id" ] || die "the app in $desktop bundles another amx than the pair released"
    [ -d "$app" ] || die "no app at $app; run the desktop gate again"
    if [ "$(shasum -a 256 "$app/Contents/MacOS/Agent Mux" | cut -d' ' -f1)" != "$(fact bundle_executable_sha256)" ]; then
        die "$app is not the bundle the desktop gate passed; run it again"
    fi
    xcrun stapler validate "$app" >/dev/null 2>&1 || die "$app carries no notarization ticket"
    spctl --assess --type execute "$app" 2>/dev/null || die "Gatekeeper refuses $app"

    local cli_zip app_zip
    stage="$(mktemp -d)" # global: the EXIT trap runs after publish returns
    trap 'rm -rf "$stage"' EXIT
    app_zip="$stage/Agent-Mux-$version-macos.zip"
    ditto -c -k --keepParent "$app" "$app_zip"

    # The standalone amx gets a Developer ID signature and its own
    # notarization. That changes the file, so it is tied to the record by Go
    # build ID, as the bundled copy is; a bare Mach-O cannot be stapled, so
    # Gatekeeper looks its ticket up online.
    mkdir "$stage/cli"
    cp "$amx_root/amx" "$stage/cli/amx"
    codesign --force --sign "$AMX_CODESIGN_IDENTITY" --options runtime --timestamp \
        --identifier io.github.sglavoie.agentmux.cli "$stage/cli/amx"
    [ "$(go tool buildid "$stage/cli/amx")" = "$build_id" ] || die "signing changed amx's build ID"
    cli_zip="$stage/amx-$version-darwin-$arch.zip"
    ditto -c -k "$stage/cli" "$cli_zip"
    echo "notarizing amx"
    xcrun notarytool submit "$cli_zip" --keychain-profile "$AMX_NOTARY_PROFILE" --wait |
        tee "$stage/notary.log"
    grep -q 'status: Accepted' "$stage/notary.log" || die "Apple did not accept amx for notarization"

    while IFS=$'\t' read -r repo root; do
        echo "pushing $pair_id to $repo's origin"
        git -C "$root" push --quiet origin "refs/tags/$pair_id"
    done < <(jq -r '.repositories[] | [.repo, .root] | @tsv' "$record")

    cp "$record" "$sig" "$desktop" "$desktop.sig" "$stage/"

    local notes="$stage/notes.md"
    {
        echo "Agent Mux $version, released as pair \`$pair_id\` with agent-session-loop."
        echo
        echo "| | |"
        echo "| --- | --- |"
        jq -r '.repositories[] | "| \(.repo) | `\(.revision)` |"' "$record"
        jq -r '"| contract set | `\(.contract.set_id)` |"' "$record"
        jq -r '.artifacts[] | "| \(.name) sha256 | `\(.sha256)` |"' "$record"
        echo
        echo "| amx Go build ID | \`$build_id\` |"
        echo
        echo "Both downloads are signed with Developer ID and notarized by Apple, for macOS on $arch."
        echo "\`Agent-Mux-$version-macos.zip\` is the app, with this \`amx\` and its tmux runtime inside."
        echo "\`amx-$version-darwin-$arch.zip\` is the command line alone. The sha256 above is of"
        echo "the unsigned build the gate tested; the signed copy differs only in its signature,"
        echo "and \`go tool buildid amx\` prints the same build ID."
        echo
        echo "The two evidence records and their signatures are attached. Verify them with:"
        echo
        echo '```bash'
        echo "ssh-keygen -Y verify -f allowed_signers -I <signer> -n agentmux-asl-release \\"
        echo "  -s $(basename "$sig") < $(basename "$record")"
        echo "ssh-keygen -Y verify -f allowed_signers -I <signer> -n agentmux-desktop-release \\"
        echo "  -s $(basename "$desktop").sig < $(basename "$desktop")"
        echo '```'
    } >"$notes"

    local gh_repo_name
    gh_repo_name="$(gh_repo "$amx_root")"
    local assets=("$app_zip" "$cli_zip")
    local file
    for file in "$record" "$sig" "$desktop" "$desktop.sig"; do
        assets+=("$stage/$(basename "$file")")
    done
    if gh release view "$pair_id" --repo "$gh_repo_name" >/dev/null 2>&1; then
        echo "release $pair_id exists; replacing its assets"
        gh release upload "$pair_id" --repo "$gh_repo_name" --clobber "${assets[@]}"
    else
        gh release create "$pair_id" --repo "$gh_repo_name" --verify-tag --latest \
            --title "amx $version" --notes-file "$notes" --generate-notes "${assets[@]}"
    fi
    gh release view "$pair_id" --repo "$gh_repo_name" --json url --jq .url
}

case "${1:-}" in
    prepare)
        [ "$#" -eq 5 ] || die "usage: publish-release prepare AMX_ROOT ASL_ROOT SIGNING_KEY NEXT_VERSION"
        preflight "$2" "$3" "$4" "$5"
        ;;
    preflight)
        [ "$#" -eq 4 ] || die "usage: publish-release preflight AMX_ROOT ASL_ROOT SIGNING_KEY"
        preflight "$2" "$3" "$4"
        ;;
    publish)
        [ "$#" -eq 4 ] || die "usage: publish-release publish AMX_ROOT PAIR_RECORD DESKTOP_RECORD"
        publish "$2" "$3" "$4"
        ;;
    *)
        die "usage: publish-release prepare|preflight|publish ..."
        ;;
esac
