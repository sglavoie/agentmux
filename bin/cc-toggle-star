#!/usr/bin/env bash
set -euo pipefail

# cc-toggle-star — Toggle ★ prefix on the active tab's title.
# Called from a Kitty keybinding with @active-kitty-window-id as $1.

if [[ $# -lt 1 ]]; then
    echo "Usage: cc-toggle-star WINDOW_ID" >&2
    exit 1
fi

WIN_ID="$1"

# Resolve the lib directory by following the symlink.
SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-title-icons.sh
source "$LIB_DIR/cc-title-icons.sh"

# Discover the Kitty socket.
TO_ARGS=()
if [[ -n "${KITTY_LISTEN_ON:-}" ]]; then
    TO_ARGS=("--to" "$KITTY_LISTEN_ON")
fi

# Get current tab info.
info="$(get_tab_info "$WIN_ID" ${TO_ARGS[@]+"${TO_ARGS[@]}"})"
tab_id="$(echo "$info" | head -n1)"
current_title="$(echo "$info" | tail -n1)"

if [[ -z "$tab_id" || "$tab_id" == "null" ]]; then
    echo "Error: Could not find tab for window $WIN_ID" >&2
    exit 1
fi

# Determine current icon state.
has_star=false
has_bolt=false
remaining="$current_title"
if [[ "$remaining" == "★ "* ]]; then
    has_star=true
    remaining="${remaining#★ }"
fi
if [[ "$remaining" == "⚡ "* ]]; then
    has_bolt=true
    remaining="${remaining#⚡ }"
fi

# Toggle the star.
if [[ "$has_star" == "true" ]]; then
    has_star=false
else
    has_star=true
fi

new_title="$(build_title "$remaining" "$has_star" "$has_bolt")"
kitten @ ${TO_ARGS[@]+"${TO_ARGS[@]}"} set-tab-title --match "id:$tab_id" "$new_title"
