#!/usr/bin/env bash
set -euo pipefail

# cc-toggle-focus — Toggle focus mode: dim all OTHER managed tabs.
# Called from a Kitty keybinding with @active-kitty-window-id as $1.
# Press F11 to dim everything except the current tab.
# Press F11 again (same tab) to restore all focus-dimmed tabs.
# Press F11 from a different tab to shift the spotlight.

if [[ $# -lt 1 ]]; then
	echo "Usage: cc-toggle-focus WINDOW_ID" >&2
	exit 1
fi

WIN_ID="$1"

# Resolve the lib directory by following the symlink.
SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-title-icons.sh
source "$LIB_DIR/cc-title-icons.sh"

# Discover the Kitty socket.
SOCKET="${KITTY_LISTEN_ON:-$(discover_socket)}"

FOCUS_FILE="${_CCM_TMPDIR}/ccm-focus-mode"

# Get full ls JSON once — used for tab enumeration and current tab lookup.
ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || ls_json=""
if [[ -z "$ls_json" ]]; then
	echo "Error: Could not query Kitty." >&2
	exit 1
fi

# Find the current tab ID for this window.
current_tab_id="$(printf '%s' "$ls_json" | jq -r --argjson wid "$WIN_ID" '
	[.[] | .tabs[] | select(.windows[] | .id == $wid) | .id] | first // ""
')"

if [[ -z "$current_tab_id" || "$current_tab_id" == "null" ]]; then
	echo "Error: Could not find tab for window '$WIN_ID'." >&2
	exit 1
fi

# Enumerate all managed tabs (those with a cc_account user var).
# Output: tab_id \t win_id \t cc_color \t cc_account
managed_tabs="$(
	printf '%s' "$ls_json" | jq -r '
	[.[] | .tabs[] |
		select([.windows[] | .user_vars.cc_account // "" | select(. != "")] | length > 0) |
		{ tab_id: .id, win_id: .windows[0].id,
		  cc_color: (.windows[0].user_vars.cc_color // ""),
		  cc_account: (.windows[0].user_vars.cc_account // "") }
	] | .[] | [.tab_id, .win_id, .cc_color, .cc_account] | @tsv'
)"

# Undim all focus-dimmed tabs.
_undim_all_focus() {
	local dim_file dim_type tab_id
	for dim_file in "${_CCM_TMPDIR}"/ccm-dim-*; do
		[[ -f "$dim_file" ]] || continue
		dim_type="$(head -n1 "$dim_file")"
		[[ "$dim_type" == "focus" ]] || continue
		tab_id="${dim_file##*ccm-dim-}"
		apply_undim "$SOCKET" "$tab_id" "" 2>/dev/null || true
	done
}

# Dim all managed tabs except the given tab ID.
_dim_others() {
	local skip_tab="$1"
	local tab_id win_id cc_color cc_account color_args
	while IFS=$'\t' read -r tab_id win_id cc_color cc_account; do
		[[ -n "$tab_id" ]] || continue
		# Skip the focused tab.
		[[ "$tab_id" != "$skip_tab" ]] || continue
		# Skip tabs that are already dimmed (manual or auto).
		if is_dimmed "$tab_id" >/dev/null 2>&1; then
			continue
		fi
		# Resolve color args from cc_color user var.
		color_args=""
		if [[ -n "$cc_color" ]]; then
			color_args="$(resolve_palette_color "$cc_color")"
		elif [[ -n "$cc_account" ]]; then
			load_accounts 2>/dev/null || true
			local color_name
			color_name="$(_account_color "$cc_account" 2>/dev/null)" || color_name=""
			if [[ -n "$color_name" ]]; then
				color_args="$(resolve_palette_color "$color_name")"
			else
				color_args="$(resolve_palette_color "gray")"
			fi
		fi
		[[ -n "$color_args" ]] || continue
		apply_dim "$SOCKET" "$tab_id" "$win_id" focus "$color_args"
	done <<<"$managed_tabs"
}

if [[ -f "$FOCUS_FILE" ]]; then
	# Focus mode is active.
	focused_tab="$(cat "$FOCUS_FILE")"

	if [[ "$focused_tab" == "$current_tab_id" ]]; then
		# Same tab — deactivate focus mode.
		_undim_all_focus
		rm -f "$FOCUS_FILE"
	else
		# Different tab — shift spotlight.
		_undim_all_focus
		_dim_others "$current_tab_id"
		printf '%s\n' "$current_tab_id" >"$FOCUS_FILE"
	fi
else
	# Focus mode is off — activate.
	_dim_others "$current_tab_id"
	printf '%s\n' "$current_tab_id" >"$FOCUS_FILE"
fi
