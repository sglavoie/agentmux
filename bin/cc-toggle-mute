#!/usr/bin/env bash
set -euo pipefail

# cc-toggle-mute — Toggle 🔇 mute on the active tab's title.
# When muted, macOS desktop notifications are suppressed but icon changes
# and activity tracking still function normally.
# Called from a Kitty keybinding with @active-kitty-window-id as $1.

if [[ $# -lt 1 ]]; then
	echo "Usage: cc-toggle-mute WINDOW_ID" >&2
	exit 1
fi

WIN_ID="$1"

# Resolve the lib directory by following the symlink.
SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-title-icons.sh
source "$LIB_DIR/cc-title-icons.sh"

# Discover the Kitty socket.
TO_ARGS=()
if [[ -n "${KITTY_LISTEN_ON:-}" ]]; then
	TO_ARGS=("--to" "$KITTY_LISTEN_ON")
fi

# Get current tab info.
info="$(get_tab_info "$WIN_ID" ${TO_ARGS[@]+"${TO_ARGS[@]}"})"
tab_id="$(echo "$info" | head -n1)"
current_title="$(echo "$info" | tail -n1)"

if [[ -z "$tab_id" || "$tab_id" == "null" ]]; then
	echo "Error: Could not find tab for window '$WIN_ID'." >&2
	exit 1
fi

# Determine current icon state.
{
	read -r has_star
	read -r has_flag
	read -r has_mute
	read -r remaining
} < <(parse_icon_prefix "$current_title")

state="$(detect_state "$current_title")"
remaining="$(strip_icons "$remaining")"

# Toggle the mute.
if [[ "$has_mute" == "true" ]]; then
	has_mute=false
	cc_mute_val=""
else
	has_mute=true
	cc_mute_val="1"
fi

new_title="$(build_title "$remaining" "$has_star" "$state" "$has_flag" "$has_mute")"
if ! kitten @ ${TO_ARGS[@]+"${TO_ARGS[@]}"} set-tab-title --match "id:$tab_id" "$new_title"; then
	echo "Error: failed to set tab title for tab $tab_id." >&2
	exit 1
fi

# Persist mute state as a Kitty user var for round-trip fidelity.
kitten @ ${TO_ARGS[@]+"${TO_ARGS[@]}"} set-user-vars --match "id:$WIN_ID" "cc_mute=${cc_mute_val}" 2>/dev/null || true
