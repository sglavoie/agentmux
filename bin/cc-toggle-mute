#!/usr/bin/env bash
set -euo pipefail

# cc-toggle-mute — Toggle 🔇 mute on the active tab's title.
# When muted, macOS desktop notifications are suppressed but icon changes
# and activity tracking still function normally.
# Called from a Kitty keybinding with @active-kitty-window-id as $1.

if [[ $# -lt 1 ]]; then
	echo "Usage: cc-toggle-mute WINDOW_ID" >&2
	exit 1
fi

WIN_ID="$1"

# Resolve the lib directory by following the symlink.
SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-title-icons.sh
source "$LIB_DIR/cc-title-icons.sh"

toggle_preamble "$WIN_ID" || exit 1

# Toggle the mute.
if [[ "$_TGL_HAS_MUTE" == "true" ]]; then
	_TGL_HAS_MUTE=false
	cc_mute_val=""
else
	_TGL_HAS_MUTE=true
	cc_mute_val="1"
fi

new_title="$(build_title "$_TGL_REMAINING" "$_TGL_HAS_STAR" "$_TGL_STATE" "$_TGL_HAS_FLAG" "$_TGL_HAS_MUTE" "$_TGL_HAS_DASHBOARD")"
if ! kitten @ ${_TGL_TO_ARGS[@]+"${_TGL_TO_ARGS[@]}"} set-tab-title --match "id:$_TGL_TAB_ID" "$new_title"; then
	echo "Error: failed to set tab title for tab $_TGL_TAB_ID." >&2
	exit 1
fi

# Persist mute state as a Kitty user var for round-trip fidelity.
kitten @ ${_TGL_TO_ARGS[@]+"${_TGL_TO_ARGS[@]}"} set-user-vars --match "id:$WIN_ID" "cc_mute=${cc_mute_val}" 2>/dev/null || true

# Re-apply tab colors (title changes can lose color overrides).
_ls_json="$(kitten @ ${_TGL_TO_ARGS[@]+"${_TGL_TO_ARGS[@]}"} ls 2>/dev/null)" || _ls_json=""
if [[ -n "$_ls_json" ]]; then
	_uv_json="$(printf '%s' "$_ls_json" | jq --argjson wid "$WIN_ID" '
		[.[] | .tabs[] | .windows[] | select(.id == $wid) | .user_vars] | first // {}
	' 2>/dev/null)" || _uv_json="{}"
	_cc_color="$(printf '%s' "$_uv_json" | jq -r '.cc_color // ""')"
	_cc_account="$(printf '%s' "$_uv_json" | jq -r '.cc_account // ""')"
	_colors=""
	if [[ -n "$_cc_color" ]]; then
		_colors="$(resolve_palette_color "$_cc_color")"
	elif [[ -n "$_cc_account" ]]; then
		load_accounts 2>/dev/null || true
		_colors="$(tab_colors_for_account "$_cc_account")" 2>/dev/null || _colors=""
	fi
	if [[ -n "$_colors" ]]; then
		# shellcheck disable=SC2086
		kitten @ ${_TGL_TO_ARGS[@]+"${_TGL_TO_ARGS[@]}"} set-tab-color --match "id:$_TGL_TAB_ID" $_colors 2>/dev/null || true
	fi
fi
