#!/usr/bin/env bash
set -euo pipefail

resolve_repo_dir() {
	local script_path script_dir
	script_path="$(readlink "$0" || echo "$0")"
	script_dir="$(cd "$(dirname "$script_path")" && pwd)"
	cd "$script_dir/.." && pwd
}

_CC_AUDIT_ROOT="$(resolve_repo_dir)"

source "$_CC_AUDIT_ROOT/lib/cc-audit/core.sh"
source "$_CC_AUDIT_ROOT/lib/cc-audit/fetch.sh"
source "$_CC_AUDIT_ROOT/lib/cc-audit/analysis.sh"
source "$_CC_AUDIT_ROOT/lib/cc-audit/report.sh"
source "$_CC_AUDIT_ROOT/lib/cc-audit/main.sh"

main "$@"
