#!/usr/bin/env bash
set -euo pipefail

# cc-launch: Launcher for managing Claude Code sessions as Kitty terminal tabs.
# Requires: kitty remote control (kitty @), jq

# ---------------------------------------------------------------------------
# Socket discovery
# ---------------------------------------------------------------------------
discover_socket() {
    if [[ -n "${KITTY_LISTEN_ON:-}" ]]; then
        echo "$KITTY_LISTEN_ON"
        return
    fi

    local latest=""
    latest="$(ls -t /tmp/kitty-* 2>/dev/null | head -n1)" || true
    if [[ -n "$latest" ]]; then
        echo "unix:$latest"
        return
    fi

    echo "Error: No kitty socket found. Set KITTY_LISTEN_ON or ensure kitty is running with remote control enabled." >&2
    exit 1
}

SOCKET=""  # Initialized in main() after argument parsing

# ---------------------------------------------------------------------------
# Config file
# ---------------------------------------------------------------------------
CONFIG_FILE="${CC_MANAGER_CONFIG:-$HOME/.config/cc-manager/sessions.conf}"
ACCOUNTS_CONFIG="${CC_MANAGER_ACCOUNTS:-${XDG_CONFIG_HOME:-$HOME/.config}/cc-manager/accounts.conf}"

# ---------------------------------------------------------------------------
# Account loading from accounts.conf
# ---------------------------------------------------------------------------
# Parallel indexed arrays (bash 3 compatible)
_ACCOUNT_NAMES=()
_ACCOUNT_DIRS=()
_ACCOUNT_COLORS=()

load_accounts() {
    _ACCOUNT_NAMES=()
    _ACCOUNT_DIRS=()
    _ACCOUNT_COLORS=()

    if [[ -f "$ACCOUNTS_CONFIG" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
            local name config_dir color
            IFS='|' read -r name config_dir color <<< "$line"
            name="$(echo "$name" | xargs)"
            config_dir="$(echo "$config_dir" | xargs)"
            color="$(echo "$color" | xargs)"
            config_dir="$(expand_tilde "$config_dir")"
            [[ -z "$name" ]] && continue
            _ACCOUNT_NAMES+=("$name")
            _ACCOUNT_DIRS+=("$config_dir")
            _ACCOUNT_COLORS+=("${color:-gray}")
        done < "$ACCOUNTS_CONFIG"
    else
        _ACCOUNT_NAMES=(work personal)
        _ACCOUNT_DIRS=("$HOME/.claude" "$HOME/.claude-personal")
        _ACCOUNT_COLORS=(green blue)
        echo "Note: No accounts.conf found at $ACCOUNTS_CONFIG; using default work/personal accounts." >&2
    fi
}

# Lookup helpers for the parallel arrays
_account_index() {
    local target="$1"
    local i
    for ((i = 0; i < ${#_ACCOUNT_NAMES[@]}; i++)); do
        if [[ "${_ACCOUNT_NAMES[$i]}" == "$target" ]]; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

_account_dir() {
    local idx
    idx="$(_account_index "$1")" || return 1
    echo "${_ACCOUNT_DIRS[$idx]}"
}

_account_color() {
    local idx
    idx="$(_account_index "$1")" || return 1
    echo "${_ACCOUNT_COLORS[$idx]}"
}

_all_account_names() {
    local IFS=' '
    echo "${_ACCOUNT_NAMES[*]}"
}

# ---------------------------------------------------------------------------
# Color palette (10 named colors)
# ---------------------------------------------------------------------------
resolve_palette_color() {
    local color="$1"
    case "$color" in
        green)  echo "active_bg=#2d7d46 active_fg=#ffffff inactive_bg=#1a4a2a inactive_fg=#aaaaaa" ;;
        blue)   echo "active_bg=#2d5a88 active_fg=#ffffff inactive_bg=#1a3655 inactive_fg=#aaaaaa" ;;
        red)    echo "active_bg=#8b2d2d active_fg=#ffffff inactive_bg=#551a1a inactive_fg=#aaaaaa" ;;
        orange) echo "active_bg=#8b5a2d active_fg=#ffffff inactive_bg=#553a1a inactive_fg=#aaaaaa" ;;
        purple) echo "active_bg=#5a2d8b active_fg=#ffffff inactive_bg=#3a1a55 inactive_fg=#aaaaaa" ;;
        teal)   echo "active_bg=#2d7d7d active_fg=#ffffff inactive_bg=#1a4a4a inactive_fg=#aaaaaa" ;;
        pink)   echo "active_bg=#8b2d6a active_fg=#ffffff inactive_bg=#551a42 inactive_fg=#aaaaaa" ;;
        yellow) echo "active_bg=#7d7d2d active_fg=#ffffff inactive_bg=#4a4a1a inactive_fg=#aaaaaa" ;;
        gray)   echo "active_bg=#555555 active_fg=#ffffff inactive_bg=#333333 inactive_fg=#aaaaaa" ;;
        cyan)   echo "active_bg=#2d6a8b active_fg=#ffffff inactive_bg=#1a4255 inactive_fg=#aaaaaa" ;;
        *)
            echo "Warning: Unknown color '$color', falling back to gray." >&2
            echo "active_bg=#555555 active_fg=#ffffff inactive_bg=#333333 inactive_fg=#aaaaaa"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Account → command mapping
# ---------------------------------------------------------------------------
claude_config_dir_for_account() {
    local account="$1"
    local config_dir
    config_dir="$(_account_dir "$account")" || {
        echo "Error: Unknown account '$account'. Available: $(_all_account_names)" >&2
        return 1
    }
    echo "$config_dir"
}

# ---------------------------------------------------------------------------
# Account → tab color mapping
# ---------------------------------------------------------------------------
tab_colors_for_account() {
    local account="$1"
    local color
    color="$(_account_color "$account")" || {
        echo "Warning: Unknown account '$account', using gray." >&2
        resolve_palette_color "gray"
        return
    }
    resolve_palette_color "$color"
}

# ---------------------------------------------------------------------------
# Build JSON mapping of config_dir → account_name (for jq --argjson)
# ---------------------------------------------------------------------------
build_accounts_json() {
    local json="{"
    local first=true
    local i
    for ((i = 0; i < ${#_ACCOUNT_NAMES[@]}; i++)); do
        [[ "$first" == "true" ]] || json+=","
        first=false
        json+="$(printf '%s:%s' \
            "$(echo "${_ACCOUNT_DIRS[$i]}" | jq -Rs '.[:-1]')" \
            "$(echo "${_ACCOUNT_NAMES[$i]}" | jq -Rs '.[:-1]')")"
    done
    json+="}"
    echo "$json"
}

# ---------------------------------------------------------------------------
# Find the account name that uses the default config dir
# ---------------------------------------------------------------------------
default_account_name() {
    local i
    for ((i = 0; i < ${#_ACCOUNT_NAMES[@]}; i++)); do
        local dir="${_ACCOUNT_DIRS[$i]}"
        if [[ -z "$dir" || "$dir" == "$HOME/.claude" ]]; then
            echo "${_ACCOUNT_NAMES[$i]}"
            return
        fi
    done
    echo "work"
}

# ---------------------------------------------------------------------------
# Tilde expansion for directory paths
# ---------------------------------------------------------------------------
expand_tilde() {
    local path="$1"
    if [[ "$path" == "~"* ]]; then
        echo "${HOME}${path:1}"
    else
        echo "$path"
    fi
}

# ---------------------------------------------------------------------------
# Check whether a tab with the given title already exists
# ---------------------------------------------------------------------------
tab_exists() {
    local title="$1"
    local ls_json
    ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || return 1
    echo "$ls_json" | jq -e --arg t "$title" '
        [.[].tabs[] | select(.title == $t)] | length > 0
    ' >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Launch a single session tab
# ---------------------------------------------------------------------------
launch_session() {
    local title="$1"
    local dir="$2"
    local account="${3:-work}"

    dir="$(expand_tilde "$dir")"

    if tab_exists "$title"; then
        echo "Skipping [$title]: already exists"
        return 1  # signal: not launched
    fi

    local config_dir colors
    config_dir="$(claude_config_dir_for_account "$account")"
    colors="$(tab_colors_for_account "$account")"

    # Build the launch command. Use kitty's --env flag for non-default config
    # dirs so the launched process is always "claude" directly (not wrapped in
    # env), which ensures kitty creates a proper interactive tab.
    local env_flag=""
    if [[ -n "$config_dir" && "$config_dir" != "$HOME/.claude" ]]; then
        env_flag="--env CLAUDE_CONFIG_DIR=$config_dir"
    fi

    # shellcheck disable=SC2086
    kitty @ --to "$SOCKET" launch --type=tab --tab-title "$title" --cwd "$dir" $env_flag claude

    # Apply tab colors. Retry a few times since Claude may briefly override
    # the tab title on startup.
    local i
    for ((i = 0; i < 5; i++)); do
        # shellcheck disable=SC2086
        if kitty @ --to "$SOCKET" set-tab-color --match "title:^${title}$" $colors 2>/dev/null; then
            break
        fi
        sleep 0.1
    done

    echo "Launched [$title] (account=$account, dir=$dir)"
    return 0
}

# ---------------------------------------------------------------------------
# Subcommand: launch all sessions from config
# ---------------------------------------------------------------------------
cmd_launch_all() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "Error: Config file not found: $CONFIG_FILE" >&2
        exit 1
    fi

    local launched=0
    local existed=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip comments and blank lines
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

        # Parse pipe-delimited fields and trim whitespace
        local title dir account
        IFS='|' read -r title dir account <<< "$line"
        title="$(echo "$title" | xargs)"
        dir="$(echo "$dir" | xargs)"
        account="$(echo "${account:-work}" | xargs)"
        [[ -z "$account" ]] && account="work"

        if launch_session "$title" "$dir" "$account"; then
            launched=$((launched + 1))
        else
            existed=$((existed + 1))
        fi
    done < "$CONFIG_FILE"

    echo "Launched $launched new session(s), $existed already existed."
}

# ---------------------------------------------------------------------------
# Subcommand: add a single ad-hoc session
# ---------------------------------------------------------------------------
cmd_add() {
    local title="${1:-}"
    local dir="${2:-}"
    local account="${3:-work}"

    if [[ -z "$title" || -z "$dir" ]]; then
        echo "Error: --add requires TITLE and DIR arguments." >&2
        echo "Usage: cc-launch --add TITLE DIR [ACCOUNT]" >&2
        exit 1
    fi

    launch_session "$title" "$dir" "$account"
}

# ---------------------------------------------------------------------------
# Subcommand: close a tab by title
# ---------------------------------------------------------------------------
cmd_close() {
    local title="${1:-}"

    if [[ -z "$title" ]]; then
        echo "Error: --close requires a TITLE argument." >&2
        exit 1
    fi

    if ! tab_exists "$title"; then
        echo "Error: No tab found with title '$title'." >&2
        exit 1
    fi

    kitty @ --to "$SOCKET" close-tab --match "title:^${title}$"
    echo "Closed tab '$title'."
}

# ---------------------------------------------------------------------------
# Subcommand: list Claude tabs
# ---------------------------------------------------------------------------
cmd_list() {
    local ls_json
    ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || {
        echo "Error: Failed to query kitty." >&2
        exit 1
    }

    local accounts_json default_account
    accounts_json="$(build_accounts_json)"
    default_account="$(default_account_name)"

    local table
    table="$(echo "$ls_json" | jq -r --argjson accounts "$accounts_json" --arg default_account "$default_account" '
        [.[] | . as $os |
            $os.tabs | to_entries[] |
            .key as $tab_idx | .value as $tab |
            select(
                [$tab.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any
            ) |
            {
                index: ($tab_idx + 1),
                title: $tab.title,
                config_dir: (
                    [$tab.windows[] | .foreground_processes[]? |
                        select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                        .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                    ] | if length > 0 then .[0] else "" end
                ),
                dir: ($tab.windows[0].cwd // "unknown"),
                status: (
                    if ($os.is_focused and $tab.is_focused)
                    then "focused"
                    else "idle"
                    end
                )
            } |
            .account = (if .config_dir != "" then ($accounts[.config_dir] // "unknown") else $default_account end) |
            del(.config_dir)
        ] | .[] |
        [(.index | tostring), .title, .account, .dir, .status] |
        @tsv
    ')"

    if [[ -z "$table" ]]; then
        echo "No Claude sessions found."
        return
    fi

    printf "%-6s %-30s %-10s %-40s %s\n" "Index" "Title" "Account" "Directory" "Status"
    printf "%-6s %-30s %-10s %-40s %s\n" "-----" "-----" "-------" "---------" "------"
    while IFS=$'\t' read -r idx title account dir status; do
        printf "%-6s %-30s %-10s %-40s %s\n" "$idx" "$title" "$account" "$dir" "$status"
    done <<< "$table"
}

# ---------------------------------------------------------------------------
# Subcommand: list available Kitty sockets
# ---------------------------------------------------------------------------
cmd_sockets() {
    local found=0
    for sock in /tmp/kitty-*; do
        [[ -e "$sock" ]] || continue
        found=1
        local pid="${sock#/tmp/kitty-}"
        local status="stale"
        if kitty @ --to "unix:$sock" ls >/dev/null 2>&1; then
            status="active"
        fi
        echo "unix:$sock  ($status, pid=$pid)"
    done

    if [[ $found -eq 0 ]]; then
        echo "No kitty sockets found in /tmp/"
    fi

    if [[ -n "${KITTY_LISTEN_ON:-}" ]]; then
        echo ""
        echo "KITTY_LISTEN_ON=$KITTY_LISTEN_ON"
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: cleanup stale sessions (tabs with W:/P: title but no Claude process)
# ---------------------------------------------------------------------------
cmd_cleanup() {
    local ls_json
    ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || {
        echo "Error: Failed to query kitty." >&2
        exit 1
    }

    # Build a regex matching title prefixes for all loaded accounts.
    # Convention: tab titles are prefixed with the account's uppercase initial
    # followed by a colon (e.g. W:project for work, C:app for client-x).
    local initials=""
    local i
    for ((i = 0; i < ${#_ACCOUNT_NAMES[@]}; i++)); do
        local ch="${_ACCOUNT_NAMES[$i]:0:1}"
        ch="$(echo "$ch" | tr '[:lower:]' '[:upper:]')"
        if [[ "$initials" != *"$ch"* ]]; then
            initials+="$ch"
        fi
    done
    [[ -z "$initials" ]] && initials="WP"
    local title_pattern="^[$initials]:"

    local stale
    stale="$(echo "$ls_json" | jq -r --arg pat "$title_pattern" '
        [.[] | .tabs[] |
            select(.title | test($pat)) |
            select(
                [.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any | not
            ) |
            { title: .title, id: .id }
        ] | .[] | [.title, (.id | tostring)] | @tsv
    ')"

    if [[ -z "$stale" ]]; then
        echo "No stale sessions found."
        return
    fi

    echo "Stale sessions (no Claude process running):"
    echo ""
    while IFS=$'\t' read -r title tab_id; do
        echo "  $title (tab id: $tab_id)"
    done <<< "$stale"
    echo ""

    read -rp "Close all stale sessions? [y/N] " answer
    if [[ "$answer" =~ ^[Yy] ]]; then
        while IFS=$'\t' read -r title tab_id; do
            kitty @ --to "$SOCKET" close-tab --match "id:$tab_id"
            echo "Closed: $title"
        done <<< "$stale"
    else
        echo "No sessions closed."
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: save current Claude sessions to config file
# ---------------------------------------------------------------------------
cmd_save() {
    local output_file="${1:-$CONFIG_FILE}"

    local ls_json
    ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || {
        echo "Error: Failed to query kitty." >&2
        exit 1
    }

    local accounts_json default_account
    accounts_json="$(build_accounts_json)"
    default_account="$(default_account_name)"

    local sessions
    sessions="$(echo "$ls_json" | jq -r --argjson accounts "$accounts_json" --arg default_account "$default_account" '
        [.[] | .tabs[] |
            select(
                [.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any
            ) |
            {
                title: .title,
                dir: .windows[0].cwd,
                config_dir: (
                    [.windows[] | .foreground_processes[]? |
                        select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                        .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                    ] | if length > 0 then .[0] else "" end
                )
            } |
            .account = (if .config_dir != "" then ($accounts[.config_dir] // "unknown") else $default_account end) |
            del(.config_dir)
        ] | .[] | [.title, .dir, .account] | @tsv
    ')"

    if [[ -z "$sessions" ]]; then
        echo "No Claude sessions to save."
        return
    fi

    if [[ -f "$output_file" ]]; then
        cp "$output_file" "${output_file}.bak"
        echo "Backed up existing config to ${output_file}.bak"
    fi

    {
        echo "# cc-manager session definitions"
        echo "# Saved by cc-launch --save on $(date '+%Y-%m-%d %H:%M:%S')"
        echo "#"
        echo "# Format: title | directory | account"
        echo ""
        while IFS=$'\t' read -r title dir account; do
            dir="${dir/#$HOME/\~}"
            printf "%-20s | %-40s | %s\n" "$title" "$dir" "$account"
        done <<< "$sessions"
    } > "$output_file"

    local count
    count="$(echo "$sessions" | wc -l | xargs)"
    echo "Saved $count session(s) to $output_file"
}

# ---------------------------------------------------------------------------
# Subcommand: help
# ---------------------------------------------------------------------------
cmd_help() {
    cat <<'USAGE'
cc-launch: Manage Claude Code sessions as Kitty terminal tabs.

Usage:
    cc-launch [--socket SOCKET] [COMMAND]

Commands:
    (none)                          Launch all sessions defined in the config file
    --add TITLE DIR [ACCOUNT]       Launch a single ad-hoc session tab
    --close TITLE                   Close the tab with the given title
    --list                          List open tabs running Claude
    --save [FILE]                   Save current Claude sessions to config file
    --cleanup                       Find and close stale sessions (dead processes)
    --sockets                       List available Kitty sockets
    --help                          Show this help message

Global options:
    --socket SOCKET     Target a specific Kitty socket (e.g. unix:/tmp/kitty-12345)

Config file (default: ~/.config/cc-manager/sessions.conf):
    Override with CC_MANAGER_CONFIG env var.
    Format (pipe-delimited):
        title | directory | account
    Lines starting with # are comments. Blank lines are ignored.

Accounts (defined in ~/.config/cc-manager/accounts.conf):
    Each line: name | claude_config_dir | color
    Colors: green, blue, red, orange, purple, teal, pink, yellow, gray, cyan
    If accounts.conf is missing, defaults to work (green) and personal (blue).

Environment:
    KITTY_LISTEN_ON      Kitty remote-control socket (auto-detected if unset)
    CC_MANAGER_CONFIG    Path to sessions config file
    CC_MANAGER_ACCOUNTS  Path to accounts config file
USAGE
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
    # Parse global --socket option
    if [[ "${1:-}" == "--socket" ]]; then
        if [[ -z "${2:-}" ]]; then
            echo "Error: --socket requires a SOCKET argument." >&2
            exit 1
        fi
        SOCKET="$2"
        shift 2
    fi

    # --sockets and --help don't need an active socket
    case "${1:-}" in
        --sockets)
            cmd_sockets
            return
            ;;
        --help|-h)
            cmd_help
            return
            ;;
    esac

    # Initialize socket if not overridden via --socket
    if [[ -z "$SOCKET" ]]; then
        SOCKET="$(discover_socket)"
    fi

    load_accounts

    case "${1:-}" in
        --add)
            shift
            cmd_add "$@"
            ;;
        --close)
            shift
            cmd_close "$@"
            ;;
        --list)
            cmd_list
            ;;
        --cleanup)
            cmd_cleanup
            ;;
        --save)
            shift
            cmd_save "$@"
            ;;
        "")
            cmd_launch_all
            ;;
        *)
            echo "Error: Unknown option '$1'. See --help for usage." >&2
            exit 1
            ;;
    esac
}

main "$@"
