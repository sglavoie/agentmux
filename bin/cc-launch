#!/usr/bin/env bash
set -euo pipefail

# cc-launch: Launcher for managing Claude Code sessions as Kitty terminal tabs.
# Requires: kitty remote control (kitty @), jq

# ---------------------------------------------------------------------------
# Shared library
# ---------------------------------------------------------------------------
source "$(dirname "$(readlink -f "$0")")/../lib/cc-common.sh"

SOCKET="" # Initialized in main() after argument parsing

# ---------------------------------------------------------------------------
# Check whether a tab with the given title already exists
# ---------------------------------------------------------------------------
tab_exists() {
	local title="$1"
	local ls_json
	ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || return 1
	echo "$ls_json" | jq -e --arg t "$title" --arg strip_re "$_STRIP_RE" '
        [.[].tabs[] | select(.title | sub($strip_re; "") | . == $t)] | length > 0
    ' >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Launch a single session tab
# ---------------------------------------------------------------------------
launch_session() {
	local title="$1"
	local dir="$2"
	local account="${3:-work}"
	local flags="${4:-}"
	local pw_override="${5:-}"
	local location_args="${6:-}"

	dir="$(expand_tilde "$dir")"

	if tab_exists "$title"; then
		echo "Skipping [$title]: already exists"
		return 1 # signal: not launched
	fi

	local config_dir colors
	config_dir="$(claude_config_dir_for_account "$account")"
	colors="$(tab_colors_for_account "$account")"

	# Build the launch command. Use kitty's --env flag for non-default config
	# dirs so the launched process is always "claude" directly (not wrapped in
	# env), which ensures kitty creates a proper interactive tab.
	# Always pass KITTY_LISTEN_ON so that hooks (e.g. cc-hook-indicator) can
	# reach the Kitty remote-control socket even without a TTY.
	local env_flag="--env KITTY_LISTEN_ON=$SOCKET"
	if [[ -n "$config_dir" && "$config_dir" != "$HOME/.claude" ]]; then
		env_flag="$env_flag --env CLAUDE_CONFIG_DIR=$config_dir"
	fi

	local effective_flags
	effective_flags="$(resolve_claude_flags "$flags")"

	local shell_cmd="exec claude $effective_flags"
	# shellcheck disable=SC2086
	kitty @ --to "$SOCKET" launch --type=tab $location_args --allow-remote-control --tab-title "$title" --cwd "$dir" --var cc_account="$account" --var cc_cwd="$dir" $env_flag "${SHELL:-/bin/zsh}" -lic "$shell_cmd"

	# Apply tab colors. Retry a few times since Claude may briefly override
	# the tab title on startup.
	local i
	for ((i = 0; i < 5; i++)); do
		# shellcheck disable=SC2086
		if kitty @ --to "$SOCKET" set-tab-color --match "title:^${title}$" $colors 2>/dev/null; then
			break
		fi
		sleep 0.1
	done

	# Launch a project window alongside Claude if configured
	local pw_mode
	pw_mode="$(resolve_project_window "$pw_override")"
	if [[ -n "$pw_mode" ]]; then
		kitty @ --to "$SOCKET" launch --type=window --match "title:^${title}$" --cwd "$dir" --keep-focus
		kitty @ --to "$SOCKET" goto-layout --match "title:^${title}$" "$pw_mode"
	fi

	echo "Launched [$title] (account=$account, dir=$dir)"
	return 0
}

# ---------------------------------------------------------------------------
# Subcommand: interactive session picker (curses UI)
# ---------------------------------------------------------------------------
cmd_launch_interactive() {
	local picker_script
	picker_script="$(dirname "$(readlink -f "$0")")/../kittens/cc_session_picker.py"

	if [[ ! -f "$picker_script" ]]; then
		echo "Error: Picker script not found: $picker_script" >&2
		exit 1
	fi

	local picker_output
	picker_output="$(python3 "$picker_script")" || {
		echo "No sessions selected."
		return
	}

	local launched=0
	local existed=0

	while IFS='|' read -r title dir account flags pw; do
		[[ -z "$title" ]] && continue
		title="$(_trim "$title")"
		dir="$(_trim "$dir")"
		account="$(_trim "${account:-work}")"
		flags="$(_trim "${flags:-}")"
		pw="$(_trim "${pw:-}")"
		[[ -z "$account" ]] && account="work"

		local insert_loc loc_args=""
		insert_loc="$(compute_insert_location "$SOCKET" "$account" "$title")"
		if [[ "$insert_loc" == "first" ]]; then
			loc_args="--location first"
		elif [[ -n "$insert_loc" ]]; then
			kitty @ --to "$SOCKET" focus-tab --match "id:$insert_loc" 2>/dev/null
			sleep 0.1
			loc_args="--location after"
		fi

		if launch_session "$title" "$dir" "$account" "$flags" "$pw" "$loc_args"; then
			launched=$((launched + 1))
		else
			existed=$((existed + 1))
		fi
	done <<<"$picker_output"

	echo "Launched $launched new session(s), $existed already existed."
}

# ---------------------------------------------------------------------------
# Subcommand: launch all sessions from config
# ---------------------------------------------------------------------------
cmd_launch_all() {
	if [[ ! -f "$CONFIG_FILE" ]]; then
		echo "Error: Config file not found: $CONFIG_FILE" >&2
		exit 1
	fi

	# Collect non-comment, non-blank lines; optionally sort by title
	local lines=""
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
		lines+="$line"$'\n'
	done <"$CONFIG_FILE"

	if [[ "$_DEFAULT_SORT_SESSIONS" == "alpha" ]]; then
		lines="$(echo -n "$lines" | sort -f)"
	fi

	local launched=0
	local existed=0

	while IFS= read -r line; do
		[[ -z "$line" ]] && continue

		# Parse pipe-delimited fields and trim whitespace
		local title dir account flags pw
		IFS='|' read -r title dir account flags pw <<<"$line"
		title="$(_trim "$title")"
		dir="$(_trim "$dir")"
		account="$(_trim "${account:-work}")"
		flags="$(_trim "${flags:-}")"
		pw="$(_trim "${pw:-}")"
		[[ -z "$account" ]] && account="work"

		local insert_loc loc_args=""
		insert_loc="$(compute_insert_location "$SOCKET" "$account" "$title")"
		if [[ "$insert_loc" == "first" ]]; then
			loc_args="--location first"
		elif [[ -n "$insert_loc" ]]; then
			kitty @ --to "$SOCKET" focus-tab --match "id:$insert_loc" 2>/dev/null
			sleep 0.1
			loc_args="--location after"
		fi

		if launch_session "$title" "$dir" "$account" "$flags" "$pw" "$loc_args"; then
			launched=$((launched + 1))
		else
			existed=$((existed + 1))
		fi
	done <<<"$lines"

	echo "Launched $launched new session(s), $existed already existed."
}

# ---------------------------------------------------------------------------
# Subcommand: add a single ad-hoc session
# ---------------------------------------------------------------------------
cmd_add() {
	local title="${1:-}"
	local dir="${2:-}"
	local account="${3:-}"

	if [[ -z "$title" || -z "$dir" ]]; then
		echo "Error: --add requires TITLE and DIR arguments." >&2
		echo "Usage: cc-launch --add TITLE DIR [ACCOUNT]" >&2
		exit 1
	fi

	if [[ -z "$account" ]]; then
		if [[ "$HAS_GUM" == "true" && ${#_ACCOUNT_NAMES[@]} -gt 1 ]]; then
			local -a display_items=()
			local i
			for ((i = 0; i < ${#_ACCOUNT_NAMES[@]}; i++)); do
				display_items+=("${_ACCOUNT_NAMES[$i]}  (${_ACCOUNT_COLORS[$i]})")
			done
			local chosen
			chosen="$(printf '%s\n' "${display_items[@]}" | gum choose \
				--header "Select account:" \
				--header.foreground "$GUM_HEADER_COLOR" \
				--cursor.foreground "$GUM_ACCENT_COLOR")" || {
				echo "No account selected."
				return
			}
			account="${chosen%%  (*}"
		elif [[ ${#_ACCOUNT_NAMES[@]} -eq 1 ]]; then
			account="${_ACCOUNT_NAMES[0]}"
		else
			account="work"
		fi
	fi

	local insert_loc loc_args=""
	insert_loc="$(compute_insert_location "$SOCKET" "$account" "$title")"
	if [[ "$insert_loc" == "first" ]]; then
		loc_args="--location first"
	elif [[ -n "$insert_loc" ]]; then
		kitty @ --to "$SOCKET" focus-tab --match "id:$insert_loc" 2>/dev/null
		sleep 0.1
		loc_args="--location after"
	fi

	launch_session "$title" "$dir" "$account" "" "" "$loc_args"
}

# ---------------------------------------------------------------------------
# Subcommand: close a tab by title
# ---------------------------------------------------------------------------
cmd_close() {
	local title="${1:-}"

	if [[ -z "$title" ]]; then
		require_gum

		discover_all_sockets
		if [[ ${#_INSTANCE_SOCKETS[@]} -eq 0 ]]; then
			echo "Error: No active Kitty instances found." >&2
			exit 1
		fi

		local multi_instance=false
		if [[ ${#_INSTANCE_SOCKETS[@]} -gt 1 ]]; then
			multi_instance=true
		fi

		# Aggregate Claude sessions from all instances
		local -a claude_entries=()  # "title\tsocket" or "title (instance)\tsocket"
		local si
		for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
			local inst_socket="${_INSTANCE_SOCKETS[$si]}"
			local inst_label="${_INSTANCE_LABELS[$si]}"
			local ls_json
			ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue

			local -a inst_titles=()
			while IFS= read -r t; do
				[[ -n "$t" ]] && inst_titles+=("$t")
			done < <(echo "$ls_json" | jq -r '
                [.[] | .tabs[] |
                    select(
                        [.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any
                    ) | .title
                ] | .[]
            ')

			local t
			for t in "${inst_titles[@]+"${inst_titles[@]}"}"; do
				if [[ "$multi_instance" == "true" ]]; then
					claude_entries+=("${t} (${inst_label})"$'\t'"${inst_socket}")
				else
					claude_entries+=("${t}"$'\t'"${inst_socket}")
				fi
			done
		done

		if [[ ${#claude_entries[@]} -eq 0 ]]; then
			echo "No Claude sessions found."
			return
		fi

		# Build display list (first column only)
		local -a display_items=()
		local entry
		for entry in "${claude_entries[@]}"; do
			display_items+=("${entry%%$'\t'*}")
		done

		local chosen
		chosen="$(printf '%s\n' "${display_items[@]}" | gum choose \
			--header "Select session to close:" \
			--header.foreground "$GUM_HEADER_COLOR" \
			--cursor.foreground "#8b2d2d")" || {
			echo "No session selected."
			return
		}

		# Find the matching entry to get the socket
		local close_socket=""
		for entry in "${claude_entries[@]}"; do
			if [[ "${entry%%$'\t'*}" == "$chosen" ]]; then
				close_socket="${entry#*$'\t'}"
				break
			fi
		done

		# Strip instance label from chosen to get the raw title
		if [[ "$multi_instance" == "true" ]]; then
			title="$(echo "$chosen" | sed 's/ (K:[0-9]*)$//')"
		else
			title="$chosen"
		fi

		kitty @ --to "$close_socket" close-tab --match "title:${_STRIP_RE}${title}$"
		echo "Closed tab '$title'."
	else
		# Title given directly — search all instances for it
		discover_all_sockets
		local si
		for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
			local inst_socket="${_INSTANCE_SOCKETS[$si]}"
			local ls_json
			ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue
			if echo "$ls_json" | jq -e --arg t "$title" --arg strip_re "$_STRIP_RE" '
				[.[].tabs[] | select(.title | sub($strip_re; "") | . == $t)] | length > 0
			' >/dev/null 2>&1; then
				kitty @ --to "$inst_socket" close-tab --match "title:${_STRIP_RE}${title}$"
				echo "Closed tab '$title'."
				return
			fi
		done
		echo "Error: No tab found with title '$title'." >&2
		exit 1
	fi
}

# ---------------------------------------------------------------------------
# Subcommand: restart a session (close + relaunch with same metadata)
# ---------------------------------------------------------------------------
cmd_restart() {
	local title="${1:-}"

	discover_all_sockets
	if [[ ${#_INSTANCE_SOCKETS[@]} -eq 0 ]]; then
		echo "Error: No active Kitty instances found." >&2
		exit 1
	fi

	local multi_instance=false
	if [[ ${#_INSTANCE_SOCKETS[@]} -gt 1 ]]; then
		multi_instance=true
	fi

	local accounts_json default_account
	accounts_json="$(build_accounts_json)"
	default_account="$(default_account_name)"

	if [[ -z "$title" ]]; then
		require_gum

		# Aggregate stripped titles from all instances
		local -a restart_entries=()  # "title\tsocket" or "title (instance)\tsocket"
		local si
		for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
			local inst_socket="${_INSTANCE_SOCKETS[$si]}"
			local inst_label="${_INSTANCE_LABELS[$si]}"
			local ls_json
			ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue

			local -a inst_titles=()
			while IFS= read -r t; do
				[[ -n "$t" ]] && inst_titles+=("$t")
			done < <(echo "$ls_json" | jq -r --arg strip_re "$_STRIP_RE" '
                [.[] | .tabs[] |
                    select(
                        [.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any
                    ) | .title | sub($strip_re; "")
                ] | .[]
            ')

			local t
			for t in "${inst_titles[@]+"${inst_titles[@]}"}"; do
				if [[ "$multi_instance" == "true" ]]; then
					restart_entries+=("${t} (${inst_label})"$'\t'"${inst_socket}")
				else
					restart_entries+=("${t}"$'\t'"${inst_socket}")
				fi
			done
		done

		if [[ ${#restart_entries[@]} -eq 0 ]]; then
			echo "No Claude sessions found."
			return
		fi

		local -a display_items=()
		local entry
		for entry in "${restart_entries[@]}"; do
			display_items+=("${entry%%$'\t'*}")
		done

		local chosen
		chosen="$(printf '%s\n' "${display_items[@]}" | gum choose \
			--header "Select session to restart:" \
			--header.foreground "$GUM_HEADER_COLOR" \
			--cursor.foreground "$GUM_ACCENT_COLOR")" || {
			echo "No session selected."
			return
		}

		# Find the matching socket
		local restart_socket=""
		for entry in "${restart_entries[@]}"; do
			if [[ "${entry%%$'\t'*}" == "$chosen" ]]; then
				restart_socket="${entry#*$'\t'}"
				break
			fi
		done

		# Strip instance label from chosen to get the raw title
		if [[ "$multi_instance" == "true" ]]; then
			title="$(echo "$chosen" | sed 's/ (K:[0-9]*)$//')"
		else
			title="$chosen"
		fi

		SOCKET="$restart_socket"
	fi

	# Find the tab metadata for the selected title across all instances
	local tab_info="" target_socket=""
	local si
	for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
		local inst_socket="${_INSTANCE_SOCKETS[$si]}"
		local ls_json
		ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue

		tab_info="$(echo "$ls_json" | jq -r --arg t "$title" --argjson accounts "$accounts_json" --arg default_account "$default_account" --arg strip_re "$_STRIP_RE" '
            [.[] | .tabs[] |
                select(
                    (.title | sub($strip_re; "")) == $t
                ) |
                {
                    tab_id: .id,
                    account: (
                        [.windows[] | .user_vars.cc_account // empty | select(. != "")] |
                        if length > 0 then .[0]
                        else
                            (
                                [.windows[] | .foreground_processes[]? |
                                    select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                                    .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                                ] | if length > 0 then
                                    (.[0] as $config_dir | $accounts[$config_dir] // "unknown")
                                else $default_account end
                            )
                        end
                    ),
                    dir: (
                        [.windows[] | .user_vars.cc_cwd // empty | select(. != "")] |
                        if length > 0 then .[0]
                        else
                            ([.windows[] |
                                select([.foreground_processes[]?.cmdline[]? | test("claude")] | any)
                            ] | if length > 0 then .[0].cwd else .windows[0].cwd end)
                        end
                    )
                }
            ] | .[0] // empty | [(.tab_id | tostring), .account, .dir] | @tsv
        ')"

		if [[ -n "$tab_info" ]]; then
			target_socket="$inst_socket"
			break
		fi
	done

	if [[ -z "$tab_info" ]]; then
		echo "Error: No tab found with title '$title'." >&2
		exit 1
	fi

	# Use the socket where the tab was found
	SOCKET="$target_socket"

	local tab_id account dir
	IFS=$'\t' read -r tab_id account dir <<<"$tab_info"

	kitty @ --to "$SOCKET" close-tab --match "id:$tab_id"
	echo "Closed tab '$title', relaunching..."
	sleep 0.3

	local insert_loc loc_args=""
	insert_loc="$(compute_insert_location "$SOCKET" "$account" "$title")"
	if [[ "$insert_loc" == "first" ]]; then
		loc_args="--location first"
	elif [[ -n "$insert_loc" ]]; then
		kitty @ --to "$SOCKET" focus-tab --match "id:$insert_loc" 2>/dev/null
		sleep 0.1
		loc_args="--location after"
	fi

	# Look up per-session flags and project_window from sessions.conf
	local cfg_flags="" cfg_pw=""
	if [[ -f "$CONFIG_FILE" ]]; then
		# Strip trailing override markers (U+203E OVERLINE) for matching
		local lookup_title="${title%%‾*}"
		local cfg_line
		while IFS= read -r cfg_line || [[ -n "$cfg_line" ]]; do
			[[ -z "$cfg_line" || "$cfg_line" =~ ^[[:space:]]*# ]] && continue
			local cfg_title cfg_f cfg_p
			IFS='|' read -r cfg_title _ _ cfg_f cfg_p <<<"$cfg_line"
			cfg_title="$(_trim "$cfg_title")"
			if [[ "$cfg_title" == "$lookup_title" ]]; then
				cfg_flags="$(_trim "${cfg_f:-}")"
				cfg_pw="$(_trim "${cfg_p:-}")"
				break
			fi
		done <"$CONFIG_FILE"
	fi

	launch_session "$title" "$dir" "$account" "$cfg_flags" "$cfg_pw" "$loc_args"
}

# ---------------------------------------------------------------------------
# Subcommand: move a session to a different Kitty instance
# ---------------------------------------------------------------------------
cmd_move() {
	local title="${1:-}"

	if [[ -z "$title" ]]; then
		echo "Error: --move requires a TITLE argument." >&2
		echo "Usage: cc-launch --move TITLE --instance TARGET" >&2
		exit 1
	fi

	if [[ -z "$_MOVE_TARGET_INSTANCE" ]]; then
		echo "Error: --move requires --instance TARGET to specify the destination." >&2
		exit 1
	fi

	discover_all_sockets
	if [[ ${#_INSTANCE_SOCKETS[@]} -eq 0 ]]; then
		echo "Error: No active Kitty instances found." >&2
		exit 1
	fi

	# Resolve target instance label to a socket
	local target_socket=""
	local si
	for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
		if [[ "${_INSTANCE_LABELS[$si]}" == "$_MOVE_TARGET_INSTANCE" ]]; then
			target_socket="${_INSTANCE_SOCKETS[$si]}"
			break
		fi
	done

	if [[ -z "$target_socket" ]]; then
		echo "Error: No active Kitty instance found with label '$_MOVE_TARGET_INSTANCE'." >&2
		echo "Available instances:" >&2
		for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
			echo "  ${_INSTANCE_LABELS[$si]}  (${_INSTANCE_SOCKETS[$si]})" >&2
		done
		exit 1
	fi

	# Find the session across all instances
	local accounts_json default_account
	accounts_json="$(build_accounts_json)"
	default_account="$(default_account_name)"

	local tab_info="" source_socket=""
	for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
		local inst_socket="${_INSTANCE_SOCKETS[$si]}"
		local ls_json
		ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue

		tab_info="$(echo "$ls_json" | jq -r --arg t "$title" --argjson accounts "$accounts_json" --arg default_account "$default_account" --arg strip_re "$_STRIP_RE" '
            [.[] | .tabs[] |
                select(
                    (.title | sub($strip_re; "")) == $t
                ) |
                {
                    tab_id: .id,
                    account: (
                        [.windows[] | .user_vars.cc_account // empty | select(. != "")] |
                        if length > 0 then .[0]
                        else
                            (
                                [.windows[] | .foreground_processes[]? |
                                    select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                                    .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                                ] | if length > 0 then
                                    (.[0] as $config_dir | $accounts[$config_dir] // "unknown")
                                else $default_account end
                            )
                        end
                    ),
                    dir: (
                        [.windows[] | .user_vars.cc_cwd // empty | select(. != "")] |
                        if length > 0 then .[0]
                        else
                            ([.windows[] |
                                select([.foreground_processes[]?.cmdline[]? | test("claude")] | any)
                            ] | if length > 0 then .[0].cwd else .windows[0].cwd end)
                        end
                    )
                }
            ] | .[0] // empty | [(.tab_id | tostring), .account, .dir] | @tsv
        ')"

		if [[ -n "$tab_info" ]]; then
			source_socket="$inst_socket"
			break
		fi
	done

	if [[ -z "$tab_info" ]]; then
		echo "Error: No tab found with title '$title'." >&2
		exit 1
	fi

	if [[ "$source_socket" == "$target_socket" ]]; then
		echo "Session '$title' is already in the target instance." >&2
		exit 1
	fi

	local tab_id account dir
	IFS=$'\t' read -r tab_id account dir <<<"$tab_info"

	# Close on source
	kitty @ --to "$source_socket" close-tab --match "id:$tab_id"
	echo "Closed tab '$title' on source instance, relaunching on $_MOVE_TARGET_INSTANCE..."
	sleep 0.3

	# Relaunch on target
	SOCKET="$target_socket"

	local insert_loc loc_args=""
	insert_loc="$(compute_insert_location "$SOCKET" "$account" "$title")"
	if [[ "$insert_loc" == "first" ]]; then
		loc_args="--location first"
	elif [[ -n "$insert_loc" ]]; then
		kitty @ --to "$SOCKET" focus-tab --match "id:$insert_loc" 2>/dev/null
		sleep 0.1
		loc_args="--location after"
	fi

	# Look up per-session flags and project_window from sessions.conf
	local cfg_flags="" cfg_pw=""
	if [[ -f "$CONFIG_FILE" ]]; then
		local lookup_title="${title%%‾*}"
		local cfg_line
		while IFS= read -r cfg_line || [[ -n "$cfg_line" ]]; do
			[[ -z "$cfg_line" || "$cfg_line" =~ ^[[:space:]]*# ]] && continue
			local cfg_title cfg_f cfg_p
			IFS='|' read -r cfg_title _ _ cfg_f cfg_p <<<"$cfg_line"
			cfg_title="$(_trim "$cfg_title")"
			if [[ "$cfg_title" == "$lookup_title" ]]; then
				cfg_flags="$(_trim "${cfg_f:-}")"
				cfg_pw="$(_trim "${cfg_p:-}")"
				break
			fi
		done <"$CONFIG_FILE"
	fi

	launch_session "$title" "$dir" "$account" "$cfg_flags" "$cfg_pw" "$loc_args"
	echo "Session '$title' moved to $_MOVE_TARGET_INSTANCE."
}

# ---------------------------------------------------------------------------
# Subcommand: list Claude tabs
# ---------------------------------------------------------------------------
cmd_list() {
	discover_all_sockets

	if [[ ${#_INSTANCE_SOCKETS[@]} -eq 0 ]]; then
		echo "Error: No active Kitty instances found." >&2
		exit 1
	fi

	local accounts_json default_account
	accounts_json="$(build_accounts_json)"
	default_account="$(default_account_name)"

	local multi_instance=false
	if [[ ${#_INSTANCE_SOCKETS[@]} -gt 1 ]]; then
		multi_instance=true
	fi

	# Collect sessions from all instances
	local table=""
	local si
	for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
		local inst_socket="${_INSTANCE_SOCKETS[$si]}"
		local inst_label="${_INSTANCE_LABELS[$si]}"
		local ls_json
		ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue

		local inst_rows
		inst_rows="$(echo "$ls_json" | jq -r --argjson accounts "$accounts_json" --arg default_account "$default_account" --arg managed_re "$_MANAGED_RE" --arg strip_re "$_STRIP_RE" --arg icon_bolt "$_ICON_BOLT" --arg icon_stop "$_ICON_STOP" --arg icon_key "$_ICON_KEY" --arg icon_error "$_ICON_ERROR" --arg icon_star "$_ICON_STAR" --arg inst_label "$inst_label" '
            [.[] | . as $os |
                $os.tabs | to_entries[] |
                .key as $tab_idx | .value as $tab |
                select(
                    [$tab.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any
                ) |
                # Only show ccm-managed tabs
                select(
                    ([$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] | length > 0) or
                    ($tab.title | test($managed_re))
                ) |
                {
                    index: ($tab_idx + 1),
                    title: $tab.title,
                    account: (
                        [$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] |
                        if length > 0 then .[0]
                        else
                            (
                                [$tab.windows[] | .foreground_processes[]? |
                                    select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                                    .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                                ] | if length > 0 then
                                    (.[0] as $config_dir | $accounts[$config_dir] // "unknown")
                                else $default_account end
                            )
                        end
                    ),
                    dir: (
                        [$tab.windows[] |
                            select([.foreground_processes[]?.cmdline[]? | test("claude")] | any)
                        ] | if length > 0 then .[0].cwd else ($tab.windows[0].cwd // "unknown") end
                    ),
                    status: (
                        if ($os.is_focused and $tab.is_focused)
                        then "focused"
                        elif ($tab.title | test("^(" + $icon_star + ")?" + $icon_bolt))
                        then "active"
                        elif ($tab.title | test("^(" + $icon_star + ")?" + $icon_stop))
                        then "stopped"
                        elif ($tab.title | test("^(" + $icon_star + ")?" + $icon_key))
                        then "permission"
                        elif ($tab.title | test("^(" + $icon_star + ")?" + $icon_error))
                        then "error"
                        else "idle"
                        end
                    ),
                    instance: $inst_label
                }
            ] | .[] |
            [(.index | tostring), .title, .account, .dir, .status, .instance] |
            @tsv
        ')"
		if [[ -n "$inst_rows" ]]; then
			if [[ -n "$table" ]]; then
				table+=$'\n'
			fi
			table+="$inst_rows"
		fi
	done

	if [[ -z "$table" ]]; then
		echo "No Claude sessions found."
		return
	fi

	init_color

	# Column headers
	local header_mk=" " header_idx="Index" header_title="Title"
	local header_account="Account" header_dir="Directory" header_status="Status"
	local header_inst="Instance"
	local max_mk=2 w1=${#header_idx} w2=${#header_title} w3=${#header_account} w4=${#header_dir} w5=${#header_status}
	local w6=${#header_inst}

	# Pre-process rows: shorten paths and compute max widths
	local -a rows=()
	while IFS=$'\t' read -r idx title account dir status instance; do
		dir="$(shorten_path "$dir")"
		rows+=("$idx"$'\t'"$title"$'\t'"$account"$'\t'"$dir"$'\t'"$status"$'\t'"$instance")
		((${#idx} > w1)) && w1=${#idx}
		((${#title} > w2)) && w2=${#title}
		((${#account} > w3)) && w3=${#account}
		((${#dir} > w4)) && w4=${#dir}
		((${#status} > w5)) && w5=${#status}
		((${#instance} > w6)) && w6=${#instance}
	done <<<"$table"

	# Header
	if [[ "$multi_instance" == "true" ]]; then
		printf "%s%-${max_mk}s%-${w1}s  %-${w2}s  %-${w3}s  %-${w6}s  %-${w4}s  %-${w5}s%s\n" \
			"$BOLD" "$header_mk" "$header_idx" "$header_title" "$header_account" "$header_inst" "$header_dir" "$header_status" "$RESET"
		printf "%s%s%s\n" "$DIM" \
			"$(repeat_char '─' $((max_mk + w1 + 2 + w2 + 2 + w3 + 2 + w6 + 2 + w4 + 2 + w5)))" \
			"$RESET"
	else
		printf "%s%-${max_mk}s%-${w1}s  %-${w2}s  %-${w3}s  %-${w4}s  %-${w5}s%s\n" \
			"$BOLD" "$header_mk" "$header_idx" "$header_title" "$header_account" "$header_dir" "$header_status" "$RESET"
		printf "%s%s%s\n" "$DIM" \
			"$(repeat_char '─' $((max_mk + w1 + 2 + w2 + 2 + w3 + 2 + w4 + 2 + w5)))" \
			"$RESET"
	fi

	# Data rows
	for row in "${rows[@]}"; do
		IFS=$'\t' read -r idx title account dir status instance <<<"$row"

		local local_mk=" "
		if [[ "$status" == "focused" ]]; then
			local_mk="▸"
		fi

		local local_color="" local_reset=""
		if [[ "$USE_COLOR" == "true" ]]; then
			local_color="$(ansi_fg_for_account "$account")"
			local_reset="$RESET"
		fi

		local local_status="$status"
		if [[ "$USE_COLOR" == "true" ]]; then
			case "$status" in
			focused) local_status="${BOLD}${status}${RESET}${local_color}" ;;
			idle) local_status="${DIM}${status}${RESET}${local_color}" ;;
			esac
		fi

		if [[ "$multi_instance" == "true" ]]; then
			printf "%s%-$((max_mk + $(extra_bytes "$local_mk")))s%-$((w1 + $(extra_bytes "$idx")))s  %-$((w2 + $(extra_bytes "$title")))s  %-$((w3 + $(extra_bytes "$account")))s  %-$((w6 + $(extra_bytes "$instance")))s  %-$((w4 + $(extra_bytes "$dir")))s  %s%s\n" \
				"$local_color" "$local_mk" "$idx" "$title" "$account" "$instance" "$dir" "$local_status" "$local_reset"
		else
			printf "%s%-$((max_mk + $(extra_bytes "$local_mk")))s%-$((w1 + $(extra_bytes "$idx")))s  %-$((w2 + $(extra_bytes "$title")))s  %-$((w3 + $(extra_bytes "$account")))s  %-$((w4 + $(extra_bytes "$dir")))s  %s%s\n" \
				"$local_color" "$local_mk" "$idx" "$title" "$account" "$dir" "$local_status" "$local_reset"
		fi
	done
}

# ---------------------------------------------------------------------------
# Subcommand: list available Kitty sockets
# ---------------------------------------------------------------------------
cmd_sockets() {
	_load_icons
	local strip_re
	strip_re="$(_icon_strip_regex)"
	local managed_re="${strip_re}[A-Z]:"

	local found=0
	for sock in /tmp/kitty-*; do
		[[ -e "$sock" ]] || continue
		found=1
		local pid="${sock#/tmp/kitty-}"
		local status="stale"
		local managed_count=""
		local ls_out
		if ls_out="$(kitty @ --to "unix:$sock" ls 2>/dev/null)"; then
			status="active"
			managed_count="$(printf '%s' "$ls_out" | jq -r --arg managed_re "$managed_re" '
				[.[] | .tabs[] | . as $tab |
					select(
						([$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] | length > 0) or
						($tab.title | test($managed_re))
					)
				] | length
			' 2>/dev/null)" || managed_count="?"
		fi
		if [[ -n "$managed_count" && "$managed_count" != "0" ]]; then
			echo "unix:$sock  ($status, pid=$pid, $managed_count managed tab(s))"
		else
			echo "unix:$sock  ($status, pid=$pid)"
		fi
	done

	if [[ $found -eq 0 ]]; then
		echo "No kitty sockets found in /tmp/"
	fi

	if [[ -n "${KITTY_LISTEN_ON:-}" ]]; then
		echo ""
		echo "KITTY_LISTEN_ON=$KITTY_LISTEN_ON"
	fi
}

# ---------------------------------------------------------------------------
# Subcommand: cleanup stale sessions (tabs with W:/P: title but no Claude process)
# ---------------------------------------------------------------------------
cmd_cleanup() {
	discover_all_sockets
	if [[ ${#_INSTANCE_SOCKETS[@]} -eq 0 ]]; then
		echo "Error: No active Kitty instances found." >&2
		exit 1
	fi

	local multi_instance=false
	if [[ ${#_INSTANCE_SOCKETS[@]} -gt 1 ]]; then
		multi_instance=true
	fi

	# Build a regex matching title prefixes for all loaded accounts.
	local initials=""
	local i
	for ((i = 0; i < ${#_ACCOUNT_NAMES[@]}; i++)); do
		local ch="${_ACCOUNT_NAMES[$i]:0:1}"
		ch="$(echo "$ch" | tr '[:lower:]' '[:upper:]')"
		if [[ "$initials" != *"$ch"* ]]; then
			initials+="$ch"
		fi
	done
	[[ -z "$initials" ]] && initials="WP"
	local title_pattern="${_STRIP_RE}[$initials]:"

	# Aggregate stale sessions from all instances
	# Each entry: "title\ttab_id\tsocket[\tinst_label]"
	local stale=""
	local live_ids=""
	local si
	for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
		local inst_socket="${_INSTANCE_SOCKETS[$si]}"
		local inst_label="${_INSTANCE_LABELS[$si]}"
		local ls_json
		ls_json="$(kitty @ --to "$inst_socket" ls 2>/dev/null)" || continue

		local inst_stale
		inst_stale="$(echo "$ls_json" | jq -r --arg pat "$title_pattern" '
            [.[] | .tabs[] |
                select(.title | test($pat)) |
                select(
                    [.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any | not
                ) |
                { title: .title, id: .id }
            ] | .[] | [.title, (.id | tostring)] | @tsv
        ')"

		if [[ -n "$inst_stale" ]]; then
			while IFS=$'\t' read -r title tab_id; do
				if [[ -n "$stale" ]]; then
					stale+=$'\n'
				fi
				stale+="${title}"$'\t'"${tab_id}"$'\t'"${inst_socket}"$'\t'"${inst_label}"
			done <<<"$inst_stale"
		fi

		# Collect live tab IDs for orphan cleanup
		local inst_live
		inst_live="$(echo "$ls_json" | jq -r --arg pat "$title_pattern" '
            [.[] | .tabs[] |
                select(
                    (.title | test($pat)) or
                    ([.windows[] | .user_vars.cc_account // empty | select(. != "")] | length > 0)
                ) | .id
            ] | .[]
        ')"
		if [[ -n "$inst_live" ]]; then
			if [[ -n "$live_ids" ]]; then
				live_ids+=$'\n'
			fi
			live_ids+="$inst_live"
		fi
	done

	if [[ -z "$stale" ]]; then
		echo "No stale sessions found."
	else
		echo "Stale sessions (no Claude process running):"
		echo ""
		while IFS=$'\t' read -r title tab_id sock inst_label; do
			if [[ "$multi_instance" == "true" ]]; then
				echo "  $title (tab id: $tab_id, instance: $inst_label)"
			else
				echo "  $title (tab id: $tab_id)"
			fi
		done <<<"$stale"
		echo ""

		local confirmed=false
		if [[ "$HAS_GUM" == "true" ]]; then
			if gum confirm "Close all stale sessions?" --affirmative "Yes, close them" --negative "Cancel"; then
				confirmed=true
			fi
		else
			read -rp "Close all stale sessions? [y/N] " answer
			if [[ "$answer" =~ ^[Yy] ]]; then
				confirmed=true
			fi
		fi

		if [[ "$confirmed" == "true" ]]; then
			while IFS=$'\t' read -r title tab_id sock inst_label; do
				kitty @ --to "$sock" close-tab --match "id:$tab_id"
				echo "Closed: $title"
			done <<<"$stale"
		else
			echo "No sessions closed."
		fi
	fi

	# Clean up orphaned activity and notification files.
	local orphaned=0
	for f in /tmp/ccm-activity-*.counts /tmp/ccm-notify-*; do
		[[ -e "$f" ]] || continue
		local fname="${f##*/}"
		local file_id=""
		case "$fname" in
		ccm-activity-*.counts)
			file_id="${fname#ccm-activity-}"
			file_id="${file_id%.counts}"
			;;
		ccm-notify-*) file_id="${fname##*-}" ;;
		esac
		[[ -z "$file_id" ]] && continue
		if ! echo "$live_ids" | grep -qx "$file_id"; then
			rm -f "$f"
			orphaned=$((orphaned + 1))
		fi
	done
	if [[ $orphaned -gt 0 ]]; then
		echo "Removed $orphaned orphaned activity/notification file(s)."
	fi
}

# ---------------------------------------------------------------------------
# Subcommand: save current Claude sessions to config file
# ---------------------------------------------------------------------------
cmd_save() {
	local output_file="${1:-$CONFIG_FILE}"

	local ls_json
	ls_json="$(kitty @ --to "$SOCKET" ls 2>/dev/null)" || {
		echo "Error: Failed to query kitty." >&2
		exit 1
	}

	local accounts_json default_account
	accounts_json="$(build_accounts_json)"
	default_account="$(default_account_name)"

	local sessions
	sessions="$(echo "$ls_json" | jq -r --argjson accounts "$accounts_json" --arg default_account "$default_account" --arg strip_re "$_STRIP_RE" '
        [.[] | .tabs[] |
            select(
                [.windows[] | .foreground_processes[]?.cmdline[]? | test("claude")] | any
            ) |
            {
                title: (.title | sub($strip_re; "") | sub("‾$"; "")),
                dir: (
                    [.windows[] |
                        select([.foreground_processes[]?.cmdline[]? | test("claude")] | any)
                    ] | if length > 0 then .[0].cwd else .windows[0].cwd end
                ),
                account: (
                    [.windows[] | .user_vars.cc_account // empty | select(. != "")] |
                    if length > 0 then .[0]
                    else
                        (
                            [.windows[] | .foreground_processes[]? |
                                select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                                .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                            ] | if length > 0 then
                                (.[0] as $config_dir | $accounts[$config_dir] // "unknown")
                            else $default_account end
                        )
                    end
                )
            }
        ] | .[] | [.title, .dir, .account] | @tsv
    ')"

	if [[ -z "$sessions" ]]; then
		echo "No Claude sessions to save."
		return
	fi

	if [[ -f "$output_file" ]]; then
		if [[ "$HAS_GUM" == "true" ]]; then
			if ! gum confirm "Overwrite $output_file? (backup will be created)" --affirmative "Yes" --negative "Cancel"; then
				echo "Save cancelled."
				return
			fi
		fi
		cp "$output_file" "${output_file}.bak"
		echo "Backed up existing config to ${output_file}.bak"
	fi

	{
		echo "# cc-manager session definitions"
		echo "# Saved by cc-launch --save on $(date '+%Y-%m-%d %H:%M:%S')"
		echo "#"
		echo "# Format: title | directory | account"
		echo ""
		while IFS=$'\t' read -r title dir account; do
			dir="${dir/#$HOME/\~}"
			printf "%-20s | %-40s | %s\n" "$title" "$dir" "$account"
		done <<<"$sessions"
	} >"$output_file"

	local count
	count="$(_trim "$(echo "$sessions" | wc -l)")"
	echo "Saved $count session(s) to $output_file"
}

# ---------------------------------------------------------------------------
# Subcommand: help
# ---------------------------------------------------------------------------
cmd_help() {
	cat <<'USAGE'
cc-launch: Manage Claude Code sessions as Kitty terminal tabs.

Usage:
    cc-launch [--socket SOCKET] [COMMAND]

Commands:
    (none)                          Interactively select sessions to launch (requires python3)
    --all                           Launch all sessions defined in the config file
    --add TITLE DIR [ACCOUNT]       Launch a single ad-hoc session tab (account picker if omitted)
    --close [TITLE]                 Close a tab (interactive picker if no title given)
    --restart [TITLE]               Close and relaunch a session (interactive picker if no title given)
    --move TITLE --instance LABEL   Move a session to a different Kitty instance
    --list                          List open tabs running Claude
    --save [FILE]                   Save current Claude sessions to config file
    --cleanup                       Find and close stale sessions (dead processes)
    --sockets                       List available Kitty sockets
    --help                          Show this help message

Global options:
    --socket SOCKET     Target a specific Kitty socket (e.g. unix:/tmp/kitty-12345)
    --instance LABEL    Target a specific Kitty instance by label (e.g. K:12345).
                        Use --sockets to list available instances.

Config file (default: ~/.config/cc-manager/sessions.conf):
    Override with CC_MANAGER_CONFIG env var.
    Format (pipe-delimited):
        title | directory | account [| claude_flags [| project_window]]
    The optional 4th column overrides the global claude_flags from defaults.conf.
    The optional 5th column overrides the global project_window from defaults.conf.
    Use "-" to disable global flags/project_window for a specific session.
    Lines starting with # are comments. Blank lines are ignored.

Accounts (defined in ~/.config/cc-manager/accounts.conf):
    Each line: name | claude_config_dir | color
    Colors: green, blue, red, orange, purple, teal, pink, yellow, gray, cyan
    If accounts.conf is missing, defaults to work (green) and personal (blue).

Defaults (defined in ~/.config/cc-manager/defaults.conf):
    Key-value pairs (key = value). Supported keys:
        claude_flags     — Extra flags passed to every Claude session
        project_window   — Open a shell window alongside Claude in each tab.
                           Values: (empty) = disabled, stack, vsplit, hsplit, split
        sort_sessions    — Sort sessions alphabetically by title on launch and
                           reorder live tabs after creating or restarting sessions.
                           Values: (empty) = file order, alpha = alphabetical
        dashboard_refresh — Auto-refresh interval (seconds) for the dashboard.
                           Values: 0 = disabled, any positive integer = interval.
                           Default: 3.

Environment:
    KITTY_LISTEN_ON      Kitty remote-control socket (auto-detected if unset)
    CC_MANAGER_CONFIG    Path to sessions config file
    CC_MANAGER_ACCOUNTS  Path to accounts config file
    CC_MANAGER_DEFAULTS  Path to defaults config file

Optional dependency:
    gum (charmbracelet/gum) — enables interactive session picker and confirmation
    dialogs. Install with: brew install gum. Falls back to non-interactive
    behavior when gum is not installed.
USAGE
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
	local instance_label=""
	_MOVE_TARGET_INSTANCE=""

	# Parse global options (--socket, --instance)
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--socket)
			if [[ -z "${2:-}" ]]; then
				echo "Error: --socket requires a SOCKET argument." >&2
				exit 1
			fi
			SOCKET="$2"
			shift 2
			;;
		--instance)
			if [[ -z "${2:-}" ]]; then
				echo "Error: --instance requires a LABEL argument (e.g. K:12345)." >&2
				exit 1
			fi
			instance_label="$2"
			shift 2
			;;
		*) break ;;
		esac
	done

	# --sockets and --help don't need an active socket
	case "${1:-}" in
	--sockets)
		cmd_sockets
		return
		;;
	--help | -h)
		cmd_help
		return
		;;
	esac

	# For --move, --instance specifies the target (not the source socket)
	if [[ "${1:-}" == "--move" && -n "$instance_label" ]]; then
		_MOVE_TARGET_INSTANCE="$instance_label"
		instance_label=""
	fi

	# Resolve --instance to a socket (for non-move commands)
	if [[ -n "$instance_label" ]]; then
		discover_all_sockets
		local si found=false
		for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
			if [[ "${_INSTANCE_LABELS[$si]}" == "$instance_label" ]]; then
				SOCKET="${_INSTANCE_SOCKETS[$si]}"
				found=true
				break
			fi
		done
		if [[ "$found" == "false" ]]; then
			echo "Error: No active Kitty instance found with label '$instance_label'." >&2
			echo "Available instances:" >&2
			for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
				echo "  ${_INSTANCE_LABELS[$si]}  (${_INSTANCE_SOCKETS[$si]})" >&2
			done
			exit 1
		fi
	fi

	# Initialize socket if not overridden via --socket or --instance
	if [[ -z "$SOCKET" ]]; then
		SOCKET="$(discover_socket)"
	fi

	load_accounts
	load_defaults
	_load_icons

	# Build shell variables for icon-based jq patterns
	_STRIP_RE="$(_icon_strip_regex)"
	_MANAGED_RE="${_STRIP_RE}[A-Z]:"

	case "${1:-}" in
	--all)
		cmd_launch_all
		;;
	--add)
		shift
		cmd_add "$@"
		;;
	--close)
		shift
		cmd_close "$@"
		;;
	--restart)
		shift
		cmd_restart "$@"
		;;
	--move)
		shift
		cmd_move "$@"
		;;
	--list)
		cmd_list
		;;
	--cleanup)
		cmd_cleanup
		;;
	--save)
		shift
		cmd_save "$@"
		;;
	"")
		if command -v python3 >/dev/null 2>&1; then
			cmd_launch_interactive
		else
			cmd_launch_all
		fi
		;;
	*)
		echo "Error: Unknown option '$1'. See --help for usage." >&2
		exit 1
		;;
	esac
}

main "$@"
