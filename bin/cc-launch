#!/usr/bin/env bash
set -euo pipefail

# cc-launch: Launcher for managing Claude Code sessions as Kitty terminal tabs.
# Requires: kitty remote control (kitty @), jq

_CC_LAUNCH_ROOT="$(dirname "$(readlink -f "$0")")/.."

# Shared library
source "$_CC_LAUNCH_ROOT/lib/cc-common.sh"

# Modularized cc-launch implementation
source "$_CC_LAUNCH_ROOT/lib/cc-launch/core.sh"
source "$_CC_LAUNCH_ROOT/lib/cc-launch/cmd_launch.sh"
source "$_CC_LAUNCH_ROOT/lib/cc-launch/cmd_lifecycle.sh"
source "$_CC_LAUNCH_ROOT/lib/cc-launch/cmd_maintenance.sh"
source "$_CC_LAUNCH_ROOT/lib/cc-launch/main.sh"

main "$@"
