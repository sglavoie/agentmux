#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# cc-status — show active Claude Code sessions running in Kitty tabs
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Shared library
# ---------------------------------------------------------------------------
source "$(dirname "$(readlink -f "$0")")/../lib/cc-common.sh"

show_help() {
    cat <<'EOF'
Usage: cc-status [--socket SOCKET] [--all] [--help]

Display a table of Kitty tabs running Claude Code sessions.
By default only ccm-managed sessions are shown (those launched via ccm).

Options:
  --socket SOCKET   Target a specific Kitty socket (e.g. unix:/tmp/kitty-12345)
  --all             Include all Claude tabs, not just ccm-managed ones
  --help            Show this help message

Columns:
  Tab        1-based tab index within the OS window
  Title      The tab's title
  Account    Account name from accounts.conf (matched by CLAUDE_CONFIG_DIR)
  Directory  The cwd of the first window in the tab
  Status     "focused" if both the tab and its OS window are focused,
             "active" if the tab title shows the ⚡ indicator, otherwise "idle"

Socket discovery:
  1. Uses --socket value if provided.
  2. Uses KITTY_LISTEN_ON if set.
  3. Otherwise globs /tmp/kitty-* and picks the most recent socket.

EOF
    exit 0
}

# ---- Argument parsing ------------------------------------------------------

SOCKET=""
SHOW_ALL=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)
            show_help
            ;;
        --all)
            SHOW_ALL=true
            shift
            ;;
        --socket)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --socket requires a SOCKET argument." >&2
                exit 1
            fi
            SOCKET="$2"
            shift 2
            ;;
        *)
            echo "Error: Unknown option '$1'. See --help for usage." >&2
            exit 1
            ;;
    esac
done

# ---- Socket discovery (if not overridden) ----------------------------------

if [[ -z "$SOCKET" ]]; then
    SOCKET="$(discover_socket)"
fi

# ---- Load accounts ---------------------------------------------------------

load_accounts

# ---- Query kitty and build the table --------------------------------------

ls_json=$(kitty @ --to "$SOCKET" ls 2>/dev/null) || {
    echo "Error: Failed to query kitty at socket $SOCKET" >&2
    exit 1
}

# Bail out if the response is empty or has no OS windows
if [[ -z "$ls_json" ]] || [[ "$(echo "$ls_json" | jq 'length')" -eq 0 ]]; then
    echo "No active Claude Code sessions found."
    exit 0
fi

# Build the accounts lookup for jq
accounts_json="$(build_accounts_json)"
default_account="$(default_account_name)"

# Use jq to extract rows for every tab that has a claude process.
# Each output line is tab-delimited: tab_index \t title \t account \t cwd \t status
rows=$(echo "$ls_json" | jq -r --argjson accounts "$accounts_json" --arg default_account "$default_account" --arg show_all "$SHOW_ALL" '
    [.[] | . as $os |
        $os.tabs | to_entries[] |
        .key as $tab_idx | .value as $tab |

        # Check whether any window in this tab has a foreground process whose
        # cmdline contains "claude"
        select(
            [ $tab.windows[]
              | .foreground_processes[]?
              | .cmdline[]?
              | test("claude")
            ] | any
        ) |

        # Filter to ccm-managed tabs unless --all is given
        select(
            $show_all == "true" or
            ([$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] | length > 0) or
            ($tab.title | test("^(★ )?(⚡ )?[A-Z]:"))
        ) |

        # Find cwd: prefer user_vars.cc_cwd (set at launch), fall back to
        # the claude window cwd, then windows[0].cwd
        (
            [$tab.windows[] | .user_vars.cc_cwd // empty | select(. != "")] |
            if length > 0 then .[0]
            else
                [$tab.windows[] |
                    select([.foreground_processes[]?.cmdline[]? | test("claude")] | any)
                ] | if length > 0 then .[0].cwd else $tab.windows[0].cwd end
            end
        ) as $cwd |

        # Determine account: prefer user_vars.cc_account, fall back to cmdline, then default
        (
            [$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] |
            if length > 0 then .[0]
            else
                (
                    [$tab.windows[] | .foreground_processes[]? |
                        select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                        .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                    ] | if length > 0 then
                        (.[0] as $config_dir | $accounts[$config_dir] // "unknown")
                    else $default_account end
                )
            end
        ) as $account |

        # Status: focused > active (⚡ indicator) > idle
        (
            if ($os.is_focused and $tab.is_focused) then "focused"
            elif ($tab.title | test("^(★ )?⚡ ")) then "active"
            else "idle"
            end
        ) as $status |

        {
            tab_index: ($tab_idx + 1),
            title: ($tab.title | sub("^★ "; "") | sub("^⚡ "; "")),
            account: $account,
            cwd: $cwd,
            status: $status
        }
    ] | .[] | [
        (.tab_index | tostring),
        .title,
        .account,
        .cwd,
        .status
    ] | join("\t")
')

if [[ -z "$rows" ]]; then
    echo "No active Claude Code sessions found."
    exit 0
fi

# ---- Helpers ----------------------------------------------------------------

# Return the number of extra bytes beyond character count (for printf padding).
# Multi-byte Unicode characters (like ★, ⚡, ·) cause printf %-Ns to under-pad
# because printf counts bytes, not visible characters.
extra_bytes() {
    local str="$1"
    local byte_len char_len
    byte_len=$(printf '%s' "$str" | LC_ALL=C wc -c)
    char_len=${#str}
    echo $(( byte_len - char_len ))
}

# ---- Print the table -------------------------------------------------------

# Determine column widths by scanning all rows (and the header)
header_tab="Tab"
header_title="Title"
header_account="Account"
header_dir="Directory"
header_status="Status"

max_tab=${#header_tab}
max_title=${#header_title}
max_account=${#header_account}
max_dir=${#header_dir}
max_status=${#header_status}

while IFS=$'\t' read -r col_tab col_title col_account col_dir col_status; do
    (( ${#col_tab}     > max_tab ))     && max_tab=${#col_tab}
    (( ${#col_title}   > max_title ))   && max_title=${#col_title}
    (( ${#col_account} > max_account )) && max_account=${#col_account}
    (( ${#col_dir}     > max_dir ))     && max_dir=${#col_dir}
    (( ${#col_status}  > max_status ))  && max_status=${#col_status}
done <<< "$rows"

# Add a little padding
fmt="%-${max_tab}s  %-${max_title}s  %-${max_account}s  %-${max_dir}s  %-${max_status}s\n"

# Header
printf "$fmt" "$header_tab" "$header_title" "$header_account" "$header_dir" "$header_status"

# Separator
sep_tab=$(printf '%*s' "$max_tab" '' | tr ' ' '-')
sep_title=$(printf '%*s' "$max_title" '' | tr ' ' '-')
sep_account=$(printf '%*s' "$max_account" '' | tr ' ' '-')
sep_dir=$(printf '%*s' "$max_dir" '' | tr ' ' '-')
sep_status=$(printf '%*s' "$max_status" '' | tr ' ' '-')
printf "$fmt" "$sep_tab" "$sep_title" "$sep_account" "$sep_dir" "$sep_status"

# Data rows (adjust printf widths for multi-byte Unicode characters)
while IFS=$'\t' read -r col_tab col_title col_account col_dir col_status; do
    printf "%-$(( max_tab + $(extra_bytes "$col_tab") ))s  %-$(( max_title + $(extra_bytes "$col_title") ))s  %-$(( max_account + $(extra_bytes "$col_account") ))s  %-$(( max_dir + $(extra_bytes "$col_dir") ))s  %-$(( max_status + $(extra_bytes "$col_status") ))s\n" \
        "$col_tab" "$col_title" "$col_account" "$col_dir" "$col_status"
done <<< "$rows"
