#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# cc-status — show active Claude Code sessions running in Kitty tabs
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Shared library
# ---------------------------------------------------------------------------
source "$(dirname "$(readlink -f "$0")")/../lib/cc-common.sh"

_require_jq

show_help() {
	cat <<'EOF'
Usage: cc-status [--socket SOCKET] [--all] [--help]

Display a table of Kitty tabs running Claude Code sessions.
By default only ccm-managed sessions are shown (those launched via ccm).

Options:
  --socket SOCKET   Target a specific Kitty socket (e.g. unix:/tmp/kitty-12345)
  --all             Include all Claude tabs, not just ccm-managed ones
  --json            Output sessions as a JSON array (for scripting)
  --help            Show this help message

Columns:
  Tab        1-based tab index within the OS window
  Title      The tab's title
  Account    Account name from accounts.conf (matched by CLAUDE_CONFIG_DIR)
  Instance   Kitty instance label (K:PID); shown when multiple instances exist
  Directory  The cwd of the first window in the tab
  Branch     Git branch name (* suffix if dirty), or - for non-git dirs
  Status     "focused" if both the tab and its OS window are focused,
             "active" if the tab title shows ⚡, "stopped" for 🛑,
             "permission" for 🔑, otherwise "idle"

Socket discovery:
  1. Uses --socket value if provided (queries only that instance).
  2. Otherwise discovers all active Kitty instances and aggregates sessions.

Environment:
  KITTY_LISTEN_ON        Kitty socket path (auto-detected if unset)
  CC_MANAGER_CONFIG      Config directory (default: ~/.config/cc-manager)
  CC_MANAGER_ACCOUNTS    Accounts file override
  CC_MANAGER_DEFAULTS    Defaults file override
  CCM_DEBUG              Set to 1 for debug output

EOF
	exit 0
}

# ---- Argument parsing ------------------------------------------------------

SOCKET=""
SHOW_ALL=false
JSON_OUTPUT=false

while [[ $# -gt 0 ]]; do
	case "$1" in
	--help)
		show_help
		;;
	--all)
		SHOW_ALL=true
		shift
		;;
	--socket)
		if [[ -z "${2:-}" ]]; then
			echo "Error: --socket requires a SOCKET argument." >&2
			exit 1
		fi
		SOCKET="$2"
		shift 2
		;;
	--json)
		JSON_OUTPUT=true
		shift
		;;
	*)
		die "Unknown option '$1'." "See 'cc-status --help' for usage."
		;;
	esac
done

# ---- Load accounts ---------------------------------------------------------

load_accounts
_load_icons

# Build shell variables for icon-based jq patterns
_STRIP_RE="$(_icon_strip_regex)"
_OVERRIDE_EMOJI_RE="(🟩|🟦|🟥|🟧|🟪|🟢|🟣|🟨|⬜|🔵)?"
_MANAGED_RE="${_STRIP_RE}${_OVERRIDE_EMOJI_RE}[A-Z]:"

# ---- Socket discovery and multi-instance query -----------------------------

# When --socket is given, query only that socket; otherwise discover all
if [[ -n "$SOCKET" ]]; then
	_INSTANCE_SOCKETS=("$SOCKET")
	# Derive label
	bare="${SOCKET#unix:}"
	base="$(basename "$bare")"
	if [[ "$base" =~ ^kitty-([0-9]+) ]]; then
		_INSTANCE_LABELS=("K:${BASH_REMATCH[1]}")
	else
		_INSTANCE_LABELS=("$SOCKET")
	fi
else
	discover_all_sockets
fi

if [[ ${#_INSTANCE_SOCKETS[@]} -eq 0 ]]; then
	die "No active Kitty instances found." \
		"Is Kitty running with remote control enabled? (allow_remote_control in kitty.conf)"
fi

multi_instance=false
if [[ ${#_INSTANCE_SOCKETS[@]} -gt 1 ]]; then
	multi_instance=true
fi

# Build the accounts lookup for jq
accounts_json="$(build_accounts_json)"
default_account="$(default_account_name)"

# Query all instances and collect rows
connection_errors=0
rows=""
for ((si = 0; si < ${#_INSTANCE_SOCKETS[@]}; si++)); do
	inst_socket="${_INSTANCE_SOCKETS[$si]}"
	inst_label="${_INSTANCE_LABELS[$si]}"
	ls_json=$(kitty @ --to "$inst_socket" ls 2>/dev/null) || {
		connection_errors=$((connection_errors + 1))
		continue
	}

	# Bail out if empty
	if [[ -z "$ls_json" ]] || [[ "$(echo "$ls_json" | jq 'length')" -eq 0 ]]; then
		continue
	fi

	inst_rows=$(echo "$ls_json" | jq -r --argjson accounts "$accounts_json" --arg default_account "$default_account" --arg show_all "$SHOW_ALL" --arg managed_re "$_MANAGED_RE" --arg strip_re "$_STRIP_RE" --arg icon_bolt "$_ICON_BOLT" --arg icon_stop "$_ICON_STOP" --arg icon_key "$_ICON_KEY" --arg icon_error "$_ICON_ERROR" --arg icon_star "$_ICON_STAR" --arg icon_flag "$_ICON_FLAG" --arg inst_label "$inst_label" '
        [.[] | . as $os |
            $os.tabs | to_entries[] |
            .key as $tab_idx | .value as $tab |

            select(
                [ $tab.windows[]
                  | .foreground_processes[]?
                  | .cmdline[]?
                  | test("claude")
                ] | any
            ) |

            select(
                $show_all == "true" or
                ([$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] | length > 0) or
                ($tab.title | test($managed_re))
            ) |

            (
                [$tab.windows[] | .user_vars.cc_cwd // empty | select(. != "")] |
                if length > 0 then .[0]
                else
                    [$tab.windows[] |
                        select([.foreground_processes[]?.cmdline[]? | test("claude")] | any)
                    ] | if length > 0 then .[0].cwd else $tab.windows[0].cwd end
                end
            ) as $cwd |

            (
                [$tab.windows[] | .user_vars.cc_account // empty | select(. != "")] |
                if length > 0 then .[0]
                else
                    (
                        [$tab.windows[] | .foreground_processes[]? |
                            select(.cmdline | any(test("CLAUDE_CONFIG_DIR"))) |
                            .cmdline[] | capture("CLAUDE_CONFIG_DIR=(?<d>.+)") | .d
                        ] | if length > 0 then
                            (.[0] as $config_dir | (first($accounts[] | select(.dir == $config_dir) | .name) // "unknown"))
                        else $default_account end
                    )
                end
            ) as $account |

            (
                if ($os.is_focused and $tab.is_focused) then "focused"
                elif ($tab.title | test("^(" + $icon_star + ")?(" + $icon_flag + ")?" + $icon_bolt)) then "active"
                elif ($tab.title | test("^(" + $icon_star + ")?(" + $icon_flag + ")?" + $icon_stop)) then "stopped"
                elif ($tab.title | test("^(" + $icon_star + ")?(" + $icon_flag + ")?" + $icon_key)) then "permission"
                elif ($tab.title | test("^(" + $icon_star + ")?(" + $icon_flag + ")?" + $icon_error)) then "error"
                else "idle"
                end
            ) as $status |

            (
                [$tab.windows[] | .user_vars.cc_group // empty | select(. != "")] |
                if length > 0 then .[0] else "" end
            ) as $group |

            {
                tab_index: ($tab_idx + 1),
                title: ($tab.title | sub($strip_re; "")),
                account: $account,
                cwd: $cwd,
                status: $status,
                instance: $inst_label,
                group: $group
            }
        ] | .[] | [
            (.tab_index | tostring),
            .title,
            .account,
            .cwd,
            .status,
            .instance,
            .group
        ] | join("\t")
    ')

	if [[ -n "$inst_rows" ]]; then
		if [[ -n "$rows" ]]; then
			rows+=$'\n'
		fi
		rows+="$inst_rows"
	fi
done

if [[ -z "$rows" ]]; then
	if [[ "$connection_errors" -eq "${#_INSTANCE_SOCKETS[@]}" ]]; then
		echo "Error: could not connect to Kitty (tried $connection_errors socket(s)). Check that remote control is enabled." >&2
	fi
	echo "No active Claude Code sessions found."
	exit 0
fi

# ---- JSON output mode ------------------------------------------------------

if [[ "$JSON_OUTPUT" == "true" ]]; then
	enriched=""
	while IFS=$'\t' read -r col_tab col_title col_account col_dir col_status col_inst col_group; do
		# Single git call for branch + dirty status
		if _git_info="$(git -C "$col_dir" status --porcelain -b 2>/dev/null)"; then
			col_branch="${_git_info%%$'\n'*}" # first line: ## branch...upstream
			col_branch="${col_branch#\#\# }"
			col_branch="${col_branch%%...*}"
			col_branch="${col_branch%% \[*}"
			[[ "$_git_info" == *$'\n'* ]] && col_branch="${col_branch}*"
		else
			col_branch="-"
		fi
		col_dir="$(shorten_path "$col_dir")"
		[[ -n "$enriched" ]] && enriched+=$'\n'
		enriched+="${col_tab}"$'\t'"${col_title}"$'\t'"${col_account}"$'\t'"${col_dir}"$'\t'"${col_branch}"$'\t'"${col_status}"$'\t'"${col_inst}"$'\t'"${col_group}"
	done <<<"$rows"
	echo "$enriched" | jq -Rs '
		[split("\n")[] | select(length > 0) | split("\t") |
		{
			tab: (.[0] | tonumber),
			title: .[1],
			account: .[2],
			directory: .[3],
			branch: .[4],
			status: .[5],
			instance: .[6],
			group: .[7]
		}]'
	exit 0
fi

# ---- Print the table -------------------------------------------------------

init_color

# Column headers
header_mk=" "
header_tab="Tab"
header_title="Title"
header_account="Account"
header_dir="Directory"
header_branch="Branch"
header_status="Status"
header_inst="Instance"
header_group="Group"

max_mk=2
max_tab=${#header_tab}
max_title=${#header_title}
max_account=${#header_account}
max_dir=${#header_dir}
max_branch=${#header_branch}
max_status=${#header_status}
max_inst=${#header_inst}
max_group=${#header_group}
has_groups=false

# Pre-process rows: shorten paths, then scan for max widths
processed_rows=""
while IFS=$'\t' read -r col_tab col_title col_account col_dir col_status col_inst col_group; do
	# Single git call for branch + dirty status
	if _git_info="$(git -C "$col_dir" status --porcelain -b 2>/dev/null)"; then
		col_branch="${_git_info%%$'\n'*}" # first line: ## branch...upstream
		col_branch="${col_branch#\#\# }"
		col_branch="${col_branch%%...*}"
		col_branch="${col_branch%% \[*}"
		[[ "$_git_info" == *$'\n'* ]] && col_branch="${col_branch}*"
	else
		col_branch="-"
	fi
	col_dir="$(shorten_path "$col_dir")"
	processed_rows+="${col_tab}"$'\t'"${col_title}"$'\t'"${col_account}"$'\t'"${col_dir}"$'\t'"${col_branch}"$'\t'"${col_status}"$'\t'"${col_inst}"$'\t'"${col_group}"$'\n'
	((${#col_tab} > max_tab)) && max_tab=${#col_tab}
	((${#col_title} > max_title)) && max_title=${#col_title}
	((${#col_account} > max_account)) && max_account=${#col_account}
	((${#col_dir} > max_dir)) && max_dir=${#col_dir}
	((${#col_branch} > max_branch)) && max_branch=${#col_branch}
	((${#col_status} > max_status)) && max_status=${#col_status}
	((${#col_inst} > max_inst)) && max_inst=${#col_inst}
	if [[ -n "$col_group" ]]; then
		has_groups=true
		((${#col_group} > max_group)) && max_group=${#col_group}
	fi
done <<<"$rows"

# Header
{
	hdr_fmt="%s%-${max_mk}s%-${max_tab}s  %-${max_title}s  %-${max_account}s"
	hdr_args=("$BOLD" "$header_mk" "$header_tab" "$header_title" "$header_account")
	sep_width=$((max_mk + max_tab + 2 + max_title + 2 + max_account))

	if [[ "$has_groups" == "true" ]]; then
		hdr_fmt+="  %-${max_group}s"
		hdr_args+=("$header_group")
		sep_width=$((sep_width + 2 + max_group))
	fi
	if [[ "$multi_instance" == "true" ]]; then
		hdr_fmt+="  %-${max_inst}s"
		hdr_args+=("$header_inst")
		sep_width=$((sep_width + 2 + max_inst))
	fi
	hdr_fmt+="  %-${max_dir}s  %-${max_branch}s  %-${max_status}s%s\n"
	hdr_args+=("$header_dir" "$header_branch" "$header_status" "$RESET")
	sep_width=$((sep_width + 2 + max_dir + 2 + max_branch + 2 + max_status))

	# shellcheck disable=SC2059  # dynamic format string is intentional
	printf "$hdr_fmt" "${hdr_args[@]}"
	printf "%s%s%s\n" "$DIM" "$(repeat_char '─' "$sep_width")" "$RESET"
}

# Data rows
while IFS=$'\t' read -r col_tab col_title col_account col_dir col_branch col_status col_inst col_group; do
	[[ -z "$col_tab" ]] && continue

	# Focus marker
	local_mk=" "
	if [[ "$col_status" == "focused" ]]; then
		local_mk="▸"
	fi

	# Row color
	local_color=""
	local_reset=""
	if [[ "$USE_COLOR" == "true" ]]; then
		local_color="$(ansi_fg_for_account "$col_account")"
		local_reset="$RESET"
	fi

	# Status styling
	local_status="$col_status"
	if [[ "$USE_COLOR" == "true" ]]; then
		case "$col_status" in
		focused) local_status="${BOLD}${col_status}${RESET}${local_color}" ;;
		stopped) local_status="${BOLD}${col_status}${RESET}${local_color}" ;;
		permission) local_status="${BOLD}${col_status}${RESET}${local_color}" ;;
		idle) local_status="${DIM}${col_status}${RESET}${local_color}" ;;
		esac
	fi

	row_fmt="%s%-$((max_mk + $(extra_bytes "$local_mk")))s%-$((max_tab + $(extra_bytes "$col_tab")))s  %-$((max_title + $(extra_bytes "$col_title")))s  %-$((max_account + $(extra_bytes "$col_account")))s"
	row_args=("$local_color" "$local_mk" "$col_tab" "$col_title" "$col_account")

	if [[ "$has_groups" == "true" ]]; then
		row_fmt+="  %-$((max_group + $(extra_bytes "$col_group")))s"
		row_args+=("$col_group")
	fi
	if [[ "$multi_instance" == "true" ]]; then
		row_fmt+="  %-$((max_inst + $(extra_bytes "$col_inst")))s"
		row_args+=("$col_inst")
	fi
	row_fmt+="  %-$((max_dir + $(extra_bytes "$col_dir")))s  %-$((max_branch + $(extra_bytes "$col_branch")))s  %s%s\n"
	row_args+=("$col_dir" "$col_branch" "$local_status" "$local_reset")

	# shellcheck disable=SC2059  # dynamic format string is intentional
	printf "$row_fmt" "${row_args[@]}"
done <<<"$processed_rows"
