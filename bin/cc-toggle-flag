#!/usr/bin/env bash
set -euo pipefail

# cc-toggle-flag — Toggle ❗flag on the active tab's title.
# Called from a Kitty keybinding with @active-kitty-window-id as $1.
# The flag is purely visual and does NOT affect tab ordering.

if [[ $# -lt 1 ]]; then
	echo "Usage: cc-toggle-flag WINDOW_ID" >&2
	exit 1
fi

WIN_ID="$1"

# Resolve the lib directory by following the symlink.
SCRIPT_PATH="$(readlink "$0" || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

# shellcheck source=../lib/cc-title-icons.sh
source "$LIB_DIR/cc-title-icons.sh"

toggle_preamble "$WIN_ID" || exit 1

# Toggle the flag.
if [[ "$_TGL_HAS_FLAG" == "true" ]]; then
	_TGL_HAS_FLAG=false
else
	_TGL_HAS_FLAG=true
fi

new_title="$(build_title "$_TGL_REMAINING" "$_TGL_HAS_STAR" "$_TGL_STATE" "$_TGL_HAS_FLAG" "$_TGL_HAS_MUTE")"
if ! kitten @ ${_TGL_TO_ARGS[@]+"${_TGL_TO_ARGS[@]}"} set-tab-title --match "id:$_TGL_TAB_ID" "$new_title"; then
	echo "Error: failed to set tab title for tab $_TGL_TAB_ID." >&2
	exit 1
fi
